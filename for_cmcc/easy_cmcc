    printf '\nWorker 内容如下，ALLOWED_TOKENS 已内嵌，请复制到 Cloudflare Worker：\n'
    printf '%s\n' '----- BEGIN easy_cmcc Worker -----'
    cat "${WORKER_FILE}"
    printf '\n%s\n\n' '----- END easy_cmcc Worker -----'
}

collect_installed_state() {
    [[ -f "${STATE_FILE}" ]] || die "easy_cmcc 尚未安装"
    load_state
    validate_protocol "${PROTOCOL:-}" || die "状态文件中的 PROTOCOL 无效"
    is_cdn_protocol "${PROTOCOL}" \
        || die "easy_cmcc 只能管理 VLESS WS + Trojan WS 的 Cloudflare CDN 安装"
    [[ -n "${VLESS_CDN_DOMAIN:-}" && -n "${VLESS_UUID:-}" \
        && -n "${TROJAN_PASSWORD:-}" && -n "${VLESS_WS_PATH:-}" \
        && -n "${TROJAN_WS_PATH:-}" ]] \
        || die "VLESS WS + Trojan WS 状态不完整"
    [[ -n "${MIERU_SERVER:-}" && -n "${MIERU_PASSWORD:-}" ]] \
        || die "Mieru 状态不完整；请执行 easy_cmcc update 完成三节点升级"
    ensure_mieru_state
    WORKER_NAME=${WORKER_NAME:-${DEFAULT_WORKER_NAME}}
}

upgrade_mieru_state_if_needed() {
    load_state
    validate_protocol "${PROTOCOL:-}" || die "状态文件中的 PROTOCOL 无效"
    if [[ -z "${MIERU_SERVER:-}" || -z "${MIERU_PASSWORD:-}" ]]; then
        info "检测到双节点旧状态，正在生成 Mieru 直连节点参数"
        ensure_mieru_state
        save_state
    fi
}

refresh_protocol_runtime_config() {
    local config_path service backup_dir backup_config
    collect_installed_state
    backup_dir=$(make_temp_dir)
    config_path=${XRAY_CONFIG}
    service=${XRAY_SERVICE}
    [[ -f "${config_path}" ]] || die "当前协议配置不存在：${config_path}"
    backup_config="${backup_dir}/config.json"
    install -m 0600 "${config_path}" "${backup_config}"

    if (
        ensure_mita_installed
        write_xray_config
        write_nginx_config
        write_mita_config
        systemctl restart "${service}"
        validate_protocol_runtime
    ); then
        success "${PROTOCOL} 运行时配置已刷新"
        return 0
    fi

    warn "新运行时配置验收失败，正在恢复旧配置"
    install -m 0600 "${backup_config}" "${config_path}"
    systemctl restart "${service}" \
        || die "恢复旧配置后无法重启 ${service}"
    validate_protocol_runtime
    die "运行时配置更新失败，已恢复旧配置"
}

