        systemctl disable --now nginx >/dev/null 2>&1 || true
    fi
}

purge_managed_mita() {
    [[ -f "${MIERU_OWNERSHIP_MARKER}" ]] || return 0
    if command -v mita >/dev/null 2>&1; then
        mita stop >/dev/null 2>&1 || true
    fi
    systemctl disable --now "${MIERU_SERVICE}" >/dev/null 2>&1 || true
    dpkg --purge mita >/dev/null 2>&1 || warn "卸载 mita 软件包失败，请手动执行 dpkg --purge mita"
    rm -rf -- "${MIERU_SYSTEM_CONFIG_DIR}" /var/lib/mita /var/run/mita "${MIERU_DIR}"
    rm -f -- "${MIERU_OWNERSHIP_MARKER}"
}

remove_managed_acme_domain() {
    local domain=${1:-}
    [[ -n "${domain}" && -x "${ACME_BIN}" ]] || return 0
    run_acme --remove -d "${domain}" --ecc >/dev/null 2>&1 || true
    rm -rf -- "${ACME_HOME:?}/${domain}" "${ACME_HOME:?}/${domain}_ecc"
}

purge_owned_acme_if_unused() {
    local certificate_rows
    [[ -f "${ACME_OWNERSHIP_MARKER}" && -x "${ACME_BIN}" ]] || return 0
    if ! certificate_rows=$(run_acme --list 2>/dev/null | tail -n +2 | awk 'NF {count++} END {print count+0}'); then
        warn "无法确认 acme.sh 是否仍有其他证书，保留 ${ACME_HOME}"
        return 0
    fi
    if ((certificate_rows > 0)); then
        warn "acme.sh 中仍有其他证书，保留证书账户目录 ${ACME_HOME}"
        return 0
    fi
    if command -v crontab >/dev/null 2>&1; then
        { crontab -l 2>/dev/null || true; } \
            | awk -v acme="${ACME_BIN}" 'index($0, acme) == 0' | crontab - \
            || warn "清理 acme.sh cron 失败，请手动检查 root crontab"
    fi
    rm -rf -- "${ACME_HOME}"
}

restore_preinstall_nftables() {
    local expected="" actual=""
    [[ -f "${STATE_DIR}/nftables.sha256" ]] && expected=$(<"${STATE_DIR}/nftables.sha256")
    [[ -f "${NFT_CONFIG}" ]] && actual=$(sha256sum "${NFT_CONFIG}" | awk '{print $1}')
    if [[ -n "${expected}" && "${actual}" != "${expected}" ]]; then
        warn "nftables 已被用户修改，不自动覆盖；当前配置保持不变"
        return 0
    fi
    if [[ -f "${BACKUP_DIR}/pre-install-nftables.conf" ]]; then
        install -m 0644 "${BACKUP_DIR}/pre-install-nftables.conf" "${NFT_CONFIG}"
        nft -f "${NFT_CONFIG}" >/dev/null 2>&1 || warn "恢复安装前 nftables 失败"
    elif [[ -f "${BACKUP_DIR}/pre-install-nftables.missing" ]]; then
        rm -f -- "${NFT_CONFIG}"
        nft flush ruleset >/dev/null 2>&1 || true
    fi
}

uninstall_all() {
    local mode=${1:-}
    require_root
    [[ -z "${mode}" || "${mode}" == "--purge" ]] \
        || die "uninstall 不支持参数 ${mode}；当前默认即为 purge"
    [[ -f "${STATE_FILE}" || -d "${STATE_DIR}" || -L "${COMMAND_PATH}" ]] \
        || die "easy_cmcc 尚未安装"
    if [[ -f "${STATE_FILE}" ]]; then
        load_state
    fi
    if [[ "${FORCE:-0}" != "1" && -t 0 ]]; then
        local answer
        read -r -p "确认彻底删除 easy_cmcc 本机服务、状态、证书和备份？[y/N]: " answer
        [[ "${answer}" =~ ^[Yy]$ ]] || die "已取消"
    fi
    stop_protocol_services
    restore_preinstall_nftables
    remove_daily_reboot_schedule
    remove_managed_acme_domain "${VLESS_CDN_DOMAIN:-}"
    purge_owned_acme_if_unused
    purge_managed_mita
    rm -f -- "${XRAY_SERVICE_FILE}" "${NGINX_CONFIG}" \
        "${COMMAND_PATH}" "${CERT_RELOAD_HOOK}"
    systemctl daemon-reload >/dev/null 2>&1 || true
    rm -rf -- "${STATE_DIR}" "${WEB_ROOT}" "${COMMAND_INSTALL_DIR}"
    success "easy_cmcc 已彻底卸载；远端 Cloudflare Worker 与 Custom Domain 未处理"
}

rollback_fresh_install() {
    warn "首次安装失败，正在恢复本机服务、nftables、crontab 与 BBR 配置"
    stop_protocol_services
    if [[ "${INSTALL_NGINX_WAS_ACTIVE:-0}" == "1" ]]; then
        systemctl enable --now nginx >/dev/null 2>&1 || true
    else
        systemctl disable --now nginx >/dev/null 2>&1 || true
    fi
    restore_preinstall_nftables
    if [[ -f "${BACKUP_DIR}/pre-install-bbr.conf" ]]; then
        install -m 0644 "${BACKUP_DIR}/pre-install-bbr.conf" "${SYSCTL_CONFIG}"
        sysctl -p "${SYSCTL_CONFIG}" >/dev/null 2>&1 || true
    elif [[ -f "${BACKUP_DIR}/pre-install-bbr.missing" ]]; then
        rm -f -- "${SYSCTL_CONFIG}"
    fi
    if [[ -f "${BACKUP_DIR}/pre-install-crontab" ]]; then
        crontab "${BACKUP_DIR}/pre-install-crontab" >/dev/null 2>&1 || true
    elif [[ -f "${BACKUP_DIR}/pre-install-crontab.missing" ]]; then
        crontab -r >/dev/null 2>&1 || true
    fi
    remove_managed_acme_domain "${VLESS_CDN_DOMAIN:-}"
    purge_owned_acme_if_unused
    purge_managed_mita
    rm -f -- "${XRAY_SERVICE_FILE}" "${NGINX_CONFIG}" \
        "${COMMAND_PATH}" "${CERT_RELOAD_HOOK}"
    systemctl daemon-reload >/dev/null 2>&1 || true
    rm -rf -- "${STATE_DIR}" "${WEB_ROOT}" "${COMMAND_INSTALL_DIR}"
    warn "首次安装产生的服务数据已清理；系统软件包和已安装内核不会降级"
}

protocol_preflight() {
    local domain=${VLESS_CDN_DOMAIN} public_ip
    alert "安装前，${domain} 的 Cloudflare A 记录必须为 DNS only / 灰云。"
    alert "如果配置了 AAAA 记录，安装前也请保持 DNS only / 灰云并指向当前 VPS 公网 IPv6。"
    public_ip=$(detect_public_ipv4) || die "无法探测本机公网 IPv4"
    verify_domain_dns "${domain}" "${public_ip}"
    if validate_domain "${MIERU_SERVER}"; then
        alert "Mieru 域名 ${MIERU_SERVER} 必须始终保持 DNS only / 灰云。"
        verify_domain_dns "${MIERU_SERVER}" "${public_ip}"
    fi
}

prepare_protocol_assets() {
    issue_certificate
    download_xray
    download_mita
}

install_protocol_runtime() {
    write_xray_config
    install_xray_service
    write_nginx_config
    write_mita_config
}

validate_protocol_runtime() {
    local attempt
    for attempt in 1 2 3 4 5; do
        if ss -H -ltn "sport = :443" 2>/dev/null | grep -q . \
            && ss -H -ltn "sport = :${MIERU_PORT}" 2>/dev/null | grep -q .; then
            systemctl is-active --quiet "${XRAY_SERVICE}" \
                && systemctl is-active --quiet nginx \
                && systemctl is-active --quiet "${MIERU_SERVICE}" \
                && mita status 2>/dev/null | grep -q 'RUNNING' \
                && return 0
        fi
        sleep 2
    done
    die "${PROTOCOL} + Mieru 服务启动验收失败"
}

cleanup_obsolete_protocol_artifacts() {
    systemctl daemon-reload >/dev/null 2>&1 || true
}

install_all() {
    local requested=${1:-} prompt_worker_name=0 prompt_download_name=0
    [[ -n "${WORKER_NAME:-}" ]] || prompt_worker_name=1
    [[ -n "${SUB_DOWNLOAD_NAME:-}" ]] || prompt_download_name=1
    require_root
    require_systemd
    [[ ! -f "${STATE_FILE}" ]] || die "easy_cmcc 已安装；请使用 easy_cmcc update，或卸载后重装"
    info "[1/9] 检查系统并选择协议"
    check_platform
    choose_protocol "${requested}"
    check_install_conflicts
    print_dns_proxy_preinstall_notice
    interactive_pause
    info "[2/9] 安装依赖并初始化服务器"
    snapshot_fresh_install
    install_packages
    initialize_server
    info "[3/9] 收集 ${PROTOCOL} 参数"
    collect_install_inputs
    protocol_preflight
    info "[4/9] 准备核心与证书"
    prepare_protocol_assets
    info "[5/9] 配置 nftables"
    configure_nftables
    info "[6/9] 安装并启动 ${PROTOCOL}"
    install_protocol_runtime
    validate_protocol_runtime
    enable_cloudflare_proxy
    unset CF_DNS_API_TOKEN
    cleanup_obsolete_protocol_artifacts
    info "[7/9] 保存状态"
    save_state
    info "[8/9] 注册 easy_cmcc 命令"
    register_easy_cmcc_command
    info "[9/9] 配置 Worker 订阅"
    configure_subscription "${prompt_worker_name}" "${prompt_download_name}"
    INSTALL_ROLLBACK_ON_EXIT=0
    show_subscription
    ! is_cdn_protocol "${PROTOCOL}" || print_dns_proxy_postinstall_notice
    success "easy_cmcc ${PROTOCOL} 安装完成"
}

usage() {
    cat <<EOF
用法: ${ENTRY_COMMAND_NAME} [命令]

  install       安装两个 WebSocket CDN 节点与 Mieru 8443/TCP 直连节点
  update        刷新 CMCC 参数、三节点运行时、Worker 与 Custom Domain
  update-sub    刷新服务端与订阅
  show|subscription|status|update-core|renew-cert|uninstall

该入口固定发布 VLESS WebSocket TLS、Trojan WebSocket TLS 与 Mieru 三个节点，并放入 AUTO/PROXY 组。
Mieru 使用公网 IP 或独立灰云域名直连 TCP 8443，不经过 Cloudflare CDN。
自动部署可绑定独立 Worker Custom Domain，并由 Cloudflare 自动创建橙云 DNS 与证书。
EOF
}

update_current_core() {
    local backup_bin="${RUNTIME_TMP}/core-backup" backup_version="${RUNTIME_TMP}/version-backup"
    local backup_mita_package="${RUNTIME_TMP}/mita-backup.deb"
    local backup_mita_version="${RUNTIME_TMP}/mita-version-backup"
    require_root
    [[ -f "${STATE_FILE}" ]] || die "easy_cmcc 尚未安装"
    upgrade_mieru_state_if_needed
    collect_installed_state
    ensure_mita_installed
    write_mita_config
    [[ -f "${MIERU_PACKAGE_FILE}" ]] \
        || die "缺少 mita 回滚包 ${MIERU_PACKAGE_FILE}；请先执行 easy_cmcc update"
    install -m 0755 "${XRAY_BIN}" "${backup_bin}"
    install -m 0600 "${MIERU_PACKAGE_FILE}" "${backup_mita_package}"
    [[ ! -f "${XRAY_DIR}/version" ]] \
        || install -m 0644 "${XRAY_DIR}/version" "${backup_version}"
    [[ ! -f "${MIERU_VERSION_FILE}" ]] \
        || install -m 0600 "${MIERU_VERSION_FILE}" "${backup_mita_version}"
    if (
        download_xray
        download_mita
        write_mita_config
        systemctl restart "${XRAY_SERVICE}"
        validate_protocol_runtime
    ); then
        success "Xray 与 mita 核心已更新"
        return 0
    fi
    warn "新核心验收失败，正在恢复 Xray 与 mita 旧版本"
    install -m 0755 "${backup_bin}" "${XRAY_BIN}"
    dpkg -i "${backup_mita_package}" >/dev/null \
        || die "恢复旧 mita 软件包失败"
    install -m 0600 "${backup_mita_package}" "${MIERU_PACKAGE_FILE}"
    [[ ! -f "${backup_version}" ]] \
        || install -m 0644 "${backup_version}" "${XRAY_DIR}/version"
    [[ ! -f "${backup_mita_version}" ]] \
        || install -m 0600 "${backup_mita_version}" "${MIERU_VERSION_FILE}"
    write_mita_config
    systemctl restart "${XRAY_SERVICE}"
    validate_protocol_runtime
    die "核心更新失败，已恢复 Xray 与 mita 旧版本"
}

main() {
    if [[ "${1:-install}" == "switch" ]]; then
        die "easy_cmcc 固定使用 VLESS WS、Trojan WS 与 Mieru 三节点，不提供协议切换"
    fi
    case "${1:-install}" in
    install) install_all "${2:-${PROTOCOL:-}}" ;;
    show) require_root; show_node ;;
    subscription) require_root; show_subscription ;;
    update) update_easy_cmcc ;;
    update-sub) update_subscription 1 ;;
    update-core) update_current_core ;;
    renew-cert) renew_certificate ;;
    status) show_status ;;
    register-command) register_easy_cmcc_command ;;
    uninstall) uninstall_all "${2:-}" ;;
    help | -h | --help) usage ;;
    *) usage; return 1 ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
