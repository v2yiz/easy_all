collect_worker_custom_domain() {
    local domain=${WORKER_CUSTOM_DOMAIN:-}
    if [[ -z "${domain}" && -t 0 ]]; then
        domain=$(prompt_value \
            "Worker 独立自定义订阅域名（推荐，例如 sub.example.com；留空仅使用 workers.dev）" "")
    fi
    if [[ -z "${domain}" ]]; then
        WORKER_CUSTOM_DOMAIN=""
