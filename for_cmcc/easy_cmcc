    local allow_prompt=${1:-0} name=${WORKER_NAME:-${DEFAULT_WORKER_NAME}}
    if [[ "${allow_prompt}" == "1" && -t 0 ]]; then
        name=$(prompt_value "Cloudflare Worker 名称" "${name}")
    fi
    validate_worker_name "${name}" || die "Worker 名称无效：${name}"
    WORKER_NAME=${name}
}

choose_subscription_download_name() {
