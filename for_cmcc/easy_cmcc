active_gemini_ip_family() {
    local strategy=""
    [[ -s "${XRAY_CONFIG}" ]] || return 1
    strategy=$(jq -r \
        '.outbounds[]? | select(.tag == "gemini-family") | .settings.domainStrategy' \
        "${XRAY_CONFIG}")
    case "${strategy}" in
    ForceIPv6 | ipv6_only) printf 'ipv6\n' ;;
    ForceIPv4 | ipv4_only) printf 'ipv4\n' ;;
    *) return 1 ;;
    esac
}

