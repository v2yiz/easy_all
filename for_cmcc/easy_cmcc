validate_protocol() {
    [[ "$1" == "dual-ws" ]]
}

choose_protocol() {
    local requested=${1:-${PROTOCOL:-}}
    requested=${requested:-dual-ws}
    case "${requested}" in
    1 | dual-ws | ws) PROTOCOL="dual-ws" ;;
    *) die "easy_cmcc 固定同时部署 VLESS WS、Trojan WS 与 Mieru" ;;
    esac
    info "easy_cmcc 将部署两个 WebSocket CDN 节点与一个 Mieru TCP 直连节点。"
}

validate_loopback_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535))
}

validate_mieru_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1025 && 10#$1 <= 65535))
}

validate_mieru_credential() {
    local value=$1 minimum=$2
    [[ ${#value} -ge ${minimum} && ${#value} -le 64 ]] \
        && [[ "${value}" =~ ^[A-Za-z0-9._~-]+$ ]]
}

collect_mieru_server() {
    local detected_ip=""
    [[ -z "${MIERU_SERVER:-}" ]] || return 0
    if detected_ip=$(detect_public_ipv4); then
        if [[ -t 0 ]]; then
            info "已自动检测 mita 直连公网 IPv4：${detected_ip}"
            MIERU_SERVER=$(prompt_value \
                "Mieru 客户端连接地址（公网 IPv4 或独立 DNS only / 灰云域名）" \
                "${detected_ip}")
        else
            MIERU_SERVER=${detected_ip}
        fi
        return 0
    fi
    if [[ -t 0 ]]; then
        warn "无法自动检测本机公网 IPv4，请手动填写 mita 直连接入地址"
        MIERU_SERVER=$(prompt_value \
            "Mieru 客户端连接地址（公网 IPv4 或独立 DNS only / 灰云域名）" "")
        return 0
    fi
    die "无法自动检测 Mieru 节点公网 IPv4；非交互模式请设置 MIERU_SERVER"
}

ensure_mieru_state() {
    MIERU_NODE_NAME=${MIERU_NODE_NAME:-${DEFAULT_MIERU_NODE_NAME}}
    collect_mieru_server
    validate_ipv4 "${MIERU_SERVER}" || validate_domain "${MIERU_SERVER}" \
        || die "MIERU_SERVER 必须是公网 IPv4 或 DNS only / 灰云域名：${MIERU_SERVER}"
    [[ "$(normalize_domain "${MIERU_SERVER}")" != "${VLESS_CDN_DOMAIN}" ]] \
        || die "Mieru 不能复用安装后会切为橙云的 CDN 域名；请使用公网 IPv4 或独立灰云域名"
    MIERU_PORT=${MIERU_PORT:-${DEFAULT_MIERU_PORT}}
    validate_mieru_port "${MIERU_PORT}" || die "MIERU_PORT 必须在 1025-65535"
    MIERU_USERNAME=${MIERU_USERNAME:-${DEFAULT_MIERU_USERNAME}}
    validate_mieru_credential "${MIERU_USERNAME}" 1 \
        || die "MIERU_USERNAME 只能使用 URL 安全字符，长度 1-64"
    MIERU_PASSWORD=${MIERU_PASSWORD:-$(generate_secret)}
    validate_mieru_credential "${MIERU_PASSWORD}" 16 \
        || die "MIERU_PASSWORD 只能使用 URL 安全字符，长度 16-64"
    MIERU_TRANSPORT=${MIERU_TRANSPORT:-${DEFAULT_MIERU_TRANSPORT}}
    [[ "${MIERU_TRANSPORT}" == "TCP" ]] \
        || die "CMCC 到 RackNerd DC2 的 Mieru 入站固定使用 TCP"
    MIERU_MULTIPLEXING=${MIERU_MULTIPLEXING:-${DEFAULT_MIERU_MULTIPLEXING}}
    [[ "${MIERU_MULTIPLEXING}" =~ ^MULTIPLEXING_(OFF|LOW|MIDDLE|HIGH)$ ]] \
        || die "MIERU_MULTIPLEXING 无效"
    MIERU_HANDSHAKE_MODE=${MIERU_HANDSHAKE_MODE:-${DEFAULT_MIERU_HANDSHAKE_MODE}}
    [[ "${MIERU_HANDSHAKE_MODE}" =~ ^HANDSHAKE_(STANDARD|NO_WAIT)$ ]] \
        || die "MIERU_HANDSHAKE_MODE 无效"
}

collect_install_inputs() {
    validate_protocol "${PROTOCOL}" || die "PROTOCOL 无效：${PROTOCOL:-空}"
    VLESS_NODE_NAME=${VLESS_NODE_NAME:-${DEFAULT_VLESS_NODE_NAME}}
    TROJAN_NODE_NAME=${TROJAN_NODE_NAME:-${DEFAULT_TROJAN_NODE_NAME}}
    VLESS_UUID=${VLESS_UUID:-$(cat /proc/sys/kernel/random/uuid)}
    validate_uuid "${VLESS_UUID}" || die "VLESS_UUID 无效：${VLESS_UUID}"
    TROJAN_PASSWORD=${TROJAN_PASSWORD:-$(generate_secret)}
    [[ ${#TROJAN_PASSWORD} -ge 16 && ${#TROJAN_PASSWORD} -le 128 ]] \
        || die "TROJAN_PASSWORD 长度必须是 16-128 字符"
    VLESS_CDN_DOMAIN=${VLESS_CDN_DOMAIN:-$(prompt_value "Cloudflare CDN 域名（安装前必须灰云）" "")}
    VLESS_CDN_DOMAIN=$(normalize_domain "${VLESS_CDN_DOMAIN}")
    validate_domain "${VLESS_CDN_DOMAIN}" || die "Cloudflare CDN 域名无效：${VLESS_CDN_DOMAIN}"
    ensure_mieru_state
    VLESS_WS_PATH=${VLESS_WS_PATH:-$(generate_ws_path vless)}
    TROJAN_WS_PATH=${TROJAN_WS_PATH:-$(generate_ws_path trojan)}
    validate_ws_path "${VLESS_WS_PATH}" || die "VLESS_WS_PATH 无效：${VLESS_WS_PATH}"
    validate_ws_path "${TROJAN_WS_PATH}" || die "TROJAN_WS_PATH 无效：${TROJAN_WS_PATH}"
    [[ "${VLESS_WS_PATH}" != "${TROJAN_WS_PATH}" ]] || die "两个 WebSocket 路径不能相同"
    XRAY_VLESS_LOOPBACK_PORT=${XRAY_VLESS_LOOPBACK_PORT:-${DEFAULT_XRAY_VLESS_LOOPBACK_PORT}}
    XRAY_TROJAN_LOOPBACK_PORT=${XRAY_TROJAN_LOOPBACK_PORT:-${DEFAULT_XRAY_TROJAN_LOOPBACK_PORT}}
    validate_loopback_port "${XRAY_VLESS_LOOPBACK_PORT}" \
        || die "XRAY_VLESS_LOOPBACK_PORT 无效：${XRAY_VLESS_LOOPBACK_PORT}"
    validate_loopback_port "${XRAY_TROJAN_LOOPBACK_PORT}" \
        || die "XRAY_TROJAN_LOOPBACK_PORT 无效：${XRAY_TROJAN_LOOPBACK_PORT}"
    [[ "${XRAY_VLESS_LOOPBACK_PORT}" != "${XRAY_TROJAN_LOOPBACK_PORT}" ]] \
        || die "两个 Xray 本机端口不能相同"
    SUB_PORT_MODE="443"
    choose_cloudflare_proxy_mode
    [[ "${SUB_PORT_MODE}" == "443" || "${SUB_PORT_MODE}" == "dynamic" ]] \
        || die "SUB_PORT_MODE 无效：${SUB_PORT_MODE}"
    ! is_cdn_protocol "${PROTOCOL}" || [[ "${SUB_PORT_MODE}" == "443" ]] \
        || die "VLESS CDN 协议不支持 dynamic 端口"
    WORKER_NAME=${WORKER_NAME:-${DEFAULT_WORKER_NAME}}
    validate_worker_name "${WORKER_NAME}" || die "Worker 名称无效：${WORKER_NAME}"
    SUB_DOWNLOAD_NAME=$(normalize_sub_download_name "${SUB_DOWNLOAD_NAME:-${DEFAULT_SUB_DOWNLOAD_NAME}}")
}

check_install_conflicts() {
    local legacy mieru_port=${MIERU_PORT:-${DEFAULT_MIERU_PORT}}
    for legacy in /etc/easy_reality /etc/easy_anytls /etc/easy_vless_wss; do
        [[ ! -d "${legacy}" ]] \
            || die "检测到不兼容的旧安装 ${legacy}；请先使用对应旧命令卸载"
    done
    [[ "${SWITCH_IN_PROGRESS:-0}" == "1" ]] && return 0
    ! dpkg-query -W -f='${Status}' mita 2>/dev/null | grep -q 'install ok installed' \
        || die "检测到已有 mita 软件包；easy_cmcc 需要独占管理 Mieru，请先卸载现有 mita"
    [[ ! -d "${MIERU_SYSTEM_CONFIG_DIR}" ]] \
        || die "检测到已有 ${MIERU_SYSTEM_CONFIG_DIR}；请先备份并移除现有 mita 配置"
    if ss -H -ltn "sport = :${SERVICE_PORT}" 2>/dev/null | grep -q .; then
        die "TCP ${SERVICE_PORT} 已被占用；easy_cmcc 仅支持专用 VPS"
    fi
    if ss -H -ltn "sport = :${mieru_port}" 2>/dev/null | grep -q .; then
        die "TCP ${mieru_port} 已被占用；无法部署 Mieru"
    fi
}

append_ssh_port() {
    local port=$1
    [[ "${port}" =~ ^[0-9]+$ ]] || return 0
    ((10#${port} >= 1 && 10#${port} <= 65535)) || return 0
    case ", ${SSH_PORTS:-}, " in
    *", ${port}, "*) ;;
    *)
        [[ -z "${SSH_PORTS:-}" ]] || SSH_PORTS+=", "
        SSH_PORTS+="${port}"
        ;;
    esac
}

detect_ssh_ports() {
    local current_port sshd_bin config
    SSH_PORTS=""
    if [[ -n "${SSH_CONNECTION:-}" ]]; then
        read -r _ _ _ current_port <<<"${SSH_CONNECTION}"
        append_ssh_port "${current_port}"
    fi
    sshd_bin=$(command -v sshd 2>/dev/null || true)
    [[ -n "${sshd_bin}" || ! -x /usr/sbin/sshd ]] || sshd_bin=/usr/sbin/sshd
    if [[ -n "${sshd_bin}" ]]; then
        while read -r current_port; do
            append_ssh_port "${current_port}"
        done < <("${sshd_bin}" -T 2>/dev/null | awk '$1 == "port" {print $2}')
    fi
    for config in /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf; do
        [[ -f "${config}" ]] || continue
        while read -r current_port; do
            append_ssh_port "${current_port}"
        done < <(awk '
            /^[[:space:]]*#/ {next}
            tolower($1) == "port" {print $2}
        ' "${config}")
    done
    [[ -n "${SSH_PORTS}" ]] || SSH_PORTS="22"
    info "nftables 将放行 SSH 端口：${SSH_PORTS}"
}

configure_nftables() {
    local ssh_ports candidate backup extra_port
    detect_ssh_ports
    ssh_ports=${SSH_PORTS}
    extra_port=""
    is_cdn_protocol "${PROTOCOL}" && extra_port=", 80"
    install -d -m 0700 "${BACKUP_DIR}"
    if [[ ! -e "${BACKUP_DIR}/pre-install-nftables.conf" \
        && ! -e "${BACKUP_DIR}/pre-install-nftables.missing" ]]; then
        if [[ -f "${NFT_CONFIG}" ]]; then
            install -m 0644 "${NFT_CONFIG}" "${BACKUP_DIR}/pre-install-nftables.conf"
        else
            install -m 0600 /dev/null "${BACKUP_DIR}/pre-install-nftables.missing"
        fi
    fi
    if [[ -f "${NFT_CONFIG}" ]]; then
        backup="${BACKUP_DIR}/nftables.$(date +%Y%m%d%H%M%S).bak"
        install -m 0644 "${NFT_CONFIG}" "${backup}"
    fi
    candidate="${RUNTIME_TMP}/nftables.conf"
    cat >"${candidate}" <<EOF
#!/usr/sbin/nft -f
flush ruleset

EOF
    if [[ "${SUB_PORT_MODE}" == "dynamic" ]]; then
        cat >>"${candidate}" <<EOF
table inet nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        tcp dport ${PORT_BASE}-65535 redirect to :${SERVICE_PORT}
    }
}

EOF
    fi
    cat >>"${candidate}" <<EOF
table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state invalid drop
        ct state { established, related } accept
        meta l4proto { icmp, ipv6-icmp } accept
        tcp dport { ${ssh_ports}, ${SERVICE_PORT}, ${MIERU_PORT:-${DEFAULT_MIERU_PORT}}${extra_port} } accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
EOF
    nft -c -f "${candidate}" || die "nftables 配置校验失败"
    install -m 0644 "${candidate}" "${NFT_CONFIG}"
    sha256sum "${candidate}" | awk '{print $1}' >"${STATE_DIR}/nftables.sha256"
    chmod 0600 "${STATE_DIR}/nftables.sha256"
    systemctl enable --now nftables >/dev/null 2>&1 || die "启用 nftables 失败"
    nft -f "${NFT_CONFIG}" || die "加载 nftables 配置失败"
}

install_acme() {
    if [[ -x "${ACME_BIN}" ]]; then
        return 0
    fi
    local cert_domain=${VLESS_CDN_DOMAIN:-example.com}
    local account_email=${ACME_EMAIL:-admin@${cert_domain}}
    local installer="${RUNTIME_TMP}/get-acme.sh"
    curl -fsSL --retry 3 https://get.acme.sh -o "${installer}" || die "下载 acme.sh 安装器失败"
    sh "${installer}" "email=${account_email}" --home "${ACME_HOME}" \
        || die "安装 acme.sh 失败"
    [[ -x "${ACME_BIN}" ]] || die "acme.sh 安装后未找到 ${ACME_BIN}"
    install -d -m 0700 "${STATE_DIR}"
    install -m 0600 /dev/null "${ACME_OWNERSHIP_MARKER}"
}

run_acme() {
    "${ACME_BIN}" "$@" --home "${ACME_HOME}"
}

collect_cloudflare_dns_credentials() {
    if [[ -z "${CF_DNS_API_TOKEN:-}" ]]; then
        CF_DNS_API_TOKEN=$(prompt_secret "Cloudflare DNS API Token（用于 acme.sh DNS-01，输入不回显）") \
            || die "非交互模式必须设置 CF_DNS_API_TOKEN"
    fi
    [[ -n "${CF_DNS_API_TOKEN}" ]] || die "Cloudflare DNS API Token 不能为空"
}

cloudflare_zone_api() {
    local method=$1 path=$2
    shift 2
    local header_file="${RUNTIME_TMP}/cf-zone-headers"
    {
        printf 'Authorization: Bearer %s\n' "${CF_DNS_API_TOKEN}"
        printf 'Accept: application/json\n'
    } >"${header_file}"
    chmod 0600 "${header_file}"
    curl -sS --connect-timeout 10 --max-time 45 --retry 2 \
        -X "${method}" -H "@${header_file}" \
        "https://api.cloudflare.com/client/v4${path}" "$@"
}

find_cloudflare_zone_id() {
    local candidate=$1 response zone_id
    while [[ "${candidate}" == *.* ]]; do
        response=$(cloudflare_zone_api GET "/zones?name=${candidate}&status=active&per_page=1") \
            || return 1
        zone_id=$(jq -r '.result[0].id // empty' <<<"${response}" 2>/dev/null || true)
        if [[ -n "${zone_id}" ]]; then
            printf '%s\n' "${zone_id}"
            return 0
        fi
        candidate=${candidate#*.}
    done
    return 1
}

enable_cloudflare_websockets() {
    is_cdn_protocol "${PROTOCOL}" && [[ -n "${CF_DNS_API_TOKEN:-}" ]] || return 0
    local zone_id response
    zone_id=$(find_cloudflare_zone_id "${VLESS_CDN_DOMAIN}") || {
        warn "Cloudflare Zone 查询失败；请在 Network 页面手动开启 WebSockets"
        return 0
    }
    response=$(cloudflare_zone_api PATCH "/zones/${zone_id}/settings/websockets" \
        -H "Content-Type: application/json" --data '{"value":"on"}') || response=""
    if jq -e '.success == true' <<<"${response}" >/dev/null 2>&1; then
        success "Cloudflare WebSockets 已开启"
    else
        warn "无法自动开启 Cloudflare WebSockets；DNS Token 还需要 Zone Settings 编辑权限，请在 Network 页面手动开启"
    fi
}

enable_cloudflare_proxy() {
    [[ "${CF_PROXY_MODE:-auto}" == "auto" && -n "${CF_DNS_API_TOKEN:-}" ]] || {
        warn "节点 DNS 保持灰云；请在确认服务正常后手动切为 Proxied / 橙云"
        return 0
    }
    local zone_id response record_id proxied updated=0 failed=0 record_type
    zone_id=$(find_cloudflare_zone_id "${VLESS_CDN_DOMAIN}") || {
        warn "Cloudflare Zone 查询失败；请手动把节点 A/AAAA 切为橙云"
        return 0
    }
    for record_type in A AAAA; do
        response=$(cloudflare_zone_api GET \
            "/zones/${zone_id}/dns_records?type=${record_type}&name=${VLESS_CDN_DOMAIN}&per_page=100") \
            || response=""
        if ! jq -e '.success == true' <<<"${response}" >/dev/null 2>&1; then
            failed=$((failed + 1))
            continue
        fi
        while IFS=$'\t' read -r record_id proxied; do
            [[ -n "${record_id}" ]] || continue
            if [[ "${proxied}" == "true" ]]; then
                updated=$((updated + 1))
                continue
            fi
            response=$(cloudflare_zone_api PATCH "/zones/${zone_id}/dns_records/${record_id}" \
                -H "Content-Type: application/json" --data '{"proxied":true}') || response=""
            if jq -e '.success == true' <<<"${response}" >/dev/null 2>&1; then
                updated=$((updated + 1))
            else
                failed=$((failed + 1))
            fi
        done < <(jq -r '.result[]? | [.id, (.proxied | tostring)] | @tsv' \
            <<<"${response}" 2>/dev/null || true)
    done
    if ((updated > 0 && failed == 0)); then
        success "Cloudflare 节点 A/AAAA 已自动切为 Proxied / 橙云"
    elif ((failed > 0)); then
        warn "部分节点 DNS 查询或更新失败；请在 Cloudflare 控制台确认 A/AAAA 均为橙云"
    else
        warn "没有找到可切换的节点 A/AAAA；请在 Cloudflare 控制台手动确认橙云"
    fi
}

