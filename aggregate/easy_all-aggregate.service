[Unit]
Description=easy_all local subscription aggregation
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /usr/local/lib/easy_all/aggregate/aggregate.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
