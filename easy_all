#!/usr/bin/env bash

set -Eeuo pipefail
umask 077
export LANG=C.UTF-8 LC_ALL=C.UTF-8

# Cron commonly starts commands with only /usr/bin:/bin. easy_all also needs
# administrative tools such as ufw and iptables-restore from the sbin paths.
readonly EASY_ALL_SYSTEM_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH="${EASY_ALL_SYSTEM_PATH}${PATH:+:${PATH}}"

EASY_ALL_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${EASY_ALL_SOURCE}" ]]; do
    EASY_ALL_SOURCE_DIR="$(cd -- "$(dirname -- "${EASY_ALL_SOURCE}")" >/dev/null 2>&1 && pwd)"
    EASY_ALL_SOURCE=$(readlink "${EASY_ALL_SOURCE}")
    [[ "${EASY_ALL_SOURCE}" == /* ]] || EASY_ALL_SOURCE="${EASY_ALL_SOURCE_DIR}/${EASY_ALL_SOURCE}"
done
readonly EASY_ALL_ROOT="$(cd -- "$(dirname -- "${EASY_ALL_SOURCE}")" >/dev/null 2>&1 && pwd)"
readonly EASY_ALL_STATE_FILE="${EASY_ALL_STATE_FILE_OVERRIDE:-/etc/easy_all/state.env}"
readonly EASY_ALL_INSTALL_DIR="/usr/local/lib/easy_all"
readonly EASY_ALL_COMMAND_PATH="/usr/local/bin/easy_all"
readonly EASY_ALL_REPOSITORY_URL="${EASY_ALL_REPOSITORY_URL_OVERRIDE:-https://github.com/v2yiz/easy_all.git}"
readonly EASY_ALL_DEFAULT_BRANCH="main"
readonly EASY_ALL_BRANCH="${EASY_ALL_BRANCH_OVERRIDE:-${EASY_ALL_BRANCH:-${EASY_ALL_DEFAULT_BRANCH}}}"
readonly EASY_ALL_RUNTIME_MANIFEST="runtime.manifest"
readonly CURRENT_STATE_VERSION="0"


launcher_die() {
    printf '\033[31m%s\033[0m\n' "$*" >&2
    exit 1
}

strip_launcher_input() {
    local esc=$'\033'
    printf '%s' "$1" | sed -e "s/${esc}\[[0-9;?]*[A-Za-z]//g" -e "s/${esc}O[A-Za-z]//g" \
        | tr -d '\000-\010\013\014\016-\037\177'
}

launcher_read_bilingual() {
    local label=$1 variable=$2 input
    printf '%s\n' "${label}" >&2
    IFS= read -r -e -p '> ' input
    printf -v "${variable}" '%s' "$(strip_launcher_input "${input}")"
}

runtime_manifest_paths() {
    local root=$1 relative_path
    local manifest="${root}/${EASY_ALL_RUNTIME_MANIFEST}"
    [[ -f "${manifest}" ]] || return 1
    while IFS= read -r relative_path || [[ -n "${relative_path}" ]]; do
        relative_path=${relative_path%$'\r'}
        [[ -n "${relative_path}" && "${relative_path}" != \#* ]] || continue
        [[ "${relative_path}" =~ ^[A-Za-z0-9._/-]+$ ]] || return 1
        case "/${relative_path}/" in
        *"/../"* | *"/./"* | *"//"*) return 1 ;;
        esac
        [[ "${relative_path}" != /* ]] || return 1
        printf '%s\n' "${relative_path}"
    done <"${manifest}"
}

runtime_tree_is_complete() {
    local root=$1 relative_path paths
    [[ -f "${root}/easy_all" ]] || return 1
    paths=$(runtime_manifest_paths "${root}") || return 1
    [[ -n "${paths}" ]] || return 1
    while IFS= read -r relative_path; do
        [[ -f "${root}/${relative_path}" ]] || return 1
    done <<<"${paths}"
}

launcher_usage() {
    cat <<'EOF'
用法: easy_all [命令]

  install          交互选择 Reality、纯 CDN 或直连+CDN
  show             显示当前节点
  subscription     显示节点与订阅信息
  self-update [--dev|--branch <分支>]
                   更新项目代码；默认 main，--dev 使用 dev
  apply            应用已安装配置；纯 CDN 与直连+CDN 只重建本机与订阅
  reality-target [域名:端口]
                   修改 Reality SNI（伪装目标）并重新应用
  rotate-dynamic-ports
                   立即刷新直连 Reality 模式的动态端口 NAT 规则
  apply-cloud      同步云端资源（纯 CDN / 直连+CDN 的 Cloudflare DNS 与证书）
  edit-sub         交互编辑订阅配置（Token + 聚合节点）与模板
  refresh-cdn-ips  立即刷新纯 CDN / 直连+CDN 的 Globalping 精选 IP 与订阅
  purge-cloudflare 清理 easy_all 创建的 Cloudflare 资源（可在未安装状态使用）
  update-core      更新当前模式的核心（Xray）
  renew-cert       重新签发当前模式的 TLS 证书
  status           显示运行状态
  cleanup-partial  清理上次中断安装留下的本机残留（未安装状态使用；不改云端资源）
  uninstall        卸载当前模式；可追加 --purge-cloud 清理托管的远端资源
  help             显示帮助

一台 VPS 只能安装一种模式。
EOF
}

# 一次读入 marker 并同时给出「模式/阶段/身份」：模式与身份必须来自同一份快照，
# 否则两次读取之间换了安装，就可能拿着旧模式的身份去比对新模式。
# 输出：absent | present|PROFILE|STAGE|STARTED_AT
launcher_marker_snapshot() {
    local file=${1:-} content profile stage started
    if [[ -z "${file}" || ! -f "${file}" ]]; then
        printf 'absent'
        return 0
    fi
    content=$(<"${file}") || { printf 'unreadable'; return 0; }
    profile=$(printf '%s\n' "${content}" | sed -n 's/^PROFILE=//p' | tail -n 1)
    stage=$(printf '%s\n' "${content}" | sed -n 's/^STAGE=//p' | tail -n 1)
    started=$(printf '%s\n' "${content}" | sed -n 's/^STARTED_AT=//p' | tail -n 1)
    printf 'present|%s|%s|%s' "${profile}" "${stage}" "${started}"
}

# 上次安装被 SSH 断线打断后，没有状态文件也就没有 uninstall 可用；这条命令是唯一
# 能从本机自救的入口。它只信安装期写入的 marker 来定位模式，不猜测、不动云端资源。
cleanup_partial_install_command() {
    local progress_file mode stage started_at answer module
    local snapshot_before snapshot_after
    local bootstrap='bash <(curl -fsSL https://raw.githubusercontent.com/v2yiz/easy_all/main/bootstrap.sh)'
    while (($# > 0)); do
        case "$1" in
        -h | --help)
            printf '用法：easy_all cleanup-partial\n'
            printf '  按安装进度标记判断上次中断的模式并清理本机残留。\n'
            return 0
            ;;
        *) launcher_die "用法：easy_all cleanup-partial" ;;
        esac
    done
    [[ "$(id -u)" -eq 0 ]] || launcher_die "请使用 root 用户运行此脚本"
    [[ ! -f "${EASY_ALL_STATE_FILE}" ]] \
        || launcher_die "easy_all 已安装；如需卸载请执行 easy_all uninstall"
    progress_file="${EASY_ALL_INSTALL_PROGRESS_FILE_OVERRIDE:-/var/lib/easy_all/install-progress.env}"
    # 模式、阶段、身份必须来自同一次读取。
    snapshot_before=$(launcher_marker_snapshot "${progress_file}")
    case "${snapshot_before}" in
    absent)
        launcher_die "未检测到安装进度标记；本机没有待清理的 easy_all 安装残留"
        ;;
    unreadable)
        launcher_die "无法读取安装进度标记 ${progress_file}；请检查权限后重试"
        ;;
    esac
    IFS='|' read -r _ mode stage started_at <<<"${snapshot_before}"
    [[ -n "${mode}" ]] || launcher_die "安装进度标记缺少模式信息（${progress_file}）；请核对标记内容或人工清理残留后重装"
    profile_file "${mode}" >/dev/null
    printf '检测到未完成的 %s 安装（中断于 %s 阶段）\n' "${mode}" "${stage}" >&2
    if [[ "${FORCE:-0}" != "1" ]]; then
        [[ -t 0 ]] || launcher_die "非交互清理必须显式设置 FORCE=1"
        launcher_read_bilingual '清理本机残留（不改动 Cloudflare 云端资源）？[y/N]:' answer
        [[ "${answer}" =~ ^[Yy]$ ]] || launcher_die "已取消"
    fi
    module=$(profile_file "${mode}") || exit 1
    export EASY_ALL_SELECTED_MODE="${mode}"
    # shellcheck source=/dev/null
    source "${module}"
    register_easy_all_command() {
        unified_register_easy_all_command
    }
    acquire_runtime_write_lock 30
    # 等待锁期间安装可能已经成功（状态文件出现），或另一个安装重新写了 marker。
    if [[ -f "${EASY_ALL_STATE_FILE}" ]]; then
        launcher_die "easy_all 已在等待期间完成安装；已取消清理。如确需卸载请执行 easy_all uninstall"
    fi
    # 等锁期间可能出现「标记消失」「无标记 -> 出现新安装标记」「同模式但换了新一次安装」，
    # 任一变化都不能按旧判断继续清理。
    snapshot_after=$(launcher_marker_snapshot "${progress_file}")
    if [[ "${snapshot_after}" != "${snapshot_before}" ]]; then
        launcher_die "等待锁期间安装进度已变化（${snapshot_before} -> ${snapshot_after}）；已取消清理，请确认后在无安装运行时重试"
    fi
    cleanup_partial_install
    # 清理会删掉 easy_all 命令本身，下一步只能用 bootstrap 入口。
    success "本机残留已清理完成；如安装期已创建云端资源，需要时用 ${bootstrap} purge-cloudflare 清理"
}

choose_install_mode() {
    local choice
    [[ -t 0 ]] || launcher_die "安装必须在交互终端中执行"
    printf '请选择安装模式：\n' >&2
    printf '  1. 直连 - Reality（直连效果良好且 IP 未被封时）\n' >&2
    printf '  2. 纯 CDN - Cloudflare XHTTP（直连不佳、IP 被封或只要 CDN 入口时）\n' >&2
    printf '  3. 直连+CDN：直连 Reality + Cloudflare（一次部署两个入口）\n' >&2
    launcher_read_bilingual '请选择 [1]（直接回车使用默认值）:' choice
    case "${choice:-1}" in
    1) printf 'reality\n' ;;
    2) printf 'cdn\n' ;;
    3) printf 'combined\n' ;;
    *) launcher_die "不支持的安装模式：${choice}" ;;
    esac
}

state_value() {
    local file=$1 key=$2 line value
    [[ -f "${file}" ]] || return 1
    line=$(grep -E "^${key}=" "${file}" | tail -n 1) || return 1
    value=${line#*=}
    value=${value#\'}
    value=${value%\'}
    value=${value#\"}
    value=${value%\"}
    printf '%s\n' "${value}"
}

detect_installed_mode() {
    local protocol="" state_version=""
    if [[ -f "${EASY_ALL_STATE_FILE}" ]]; then
        protocol=$(state_value "${EASY_ALL_STATE_FILE}" PROTOCOL || true)
        state_version=$(state_value "${EASY_ALL_STATE_FILE}" STATE_VERSION || true)
        [[ "${state_version}" == "${CURRENT_STATE_VERSION}" ]] \
            || launcher_die "状态版本不匹配（当前：${state_version:-缺失}，期望：${CURRENT_STATE_VERSION}）；当前版本无法接管这份状态，请先删除 ${EASY_ALL_STATE_FILE} 并清理 /etc/easy_all 后重新安装"
        case "${protocol}" in
        reality|cdn|combined)
            printf '%s\n' "${protocol}"
            ;;
        *) launcher_die "无法识别已安装协议：${protocol:-缺失}" ;;
        esac
        return
    fi
}

profile_file() {
    local mode=$1 candidate
    case "${mode}" in
    reality) candidate="${EASY_ALL_ROOT}/profiles/reality.sh" ;;
    cdn) candidate="${EASY_ALL_ROOT}/profiles/cdn.sh" ;;
    combined) candidate="${EASY_ALL_ROOT}/profiles/combined.sh" ;;
    *) launcher_die "不支持的安装模式：${mode}" ;;
    esac
    [[ -f "${candidate}" ]] || launcher_die "缺少 Profile 模块：${candidate}"
    printf '%s\n' "${candidate}"
}

unified_register_easy_all_command() {
    local source_root=${EASY_ALL_ROOT} destination="${EASY_ALL_INSTALL_DIR}/easy_all"
    local stage backup="${EASY_ALL_INSTALL_DIR}.previous.$$" relative_path paths
    local -a syntax_files
    require_root
    runtime_tree_is_complete "${source_root}" \
        || die "easy_all 运行时文件不完整：${source_root}"
    paths=$(runtime_manifest_paths "${source_root}") \
        || die "easy_all 运行时清单无效：${source_root}/${EASY_ALL_RUNTIME_MANIFEST}"

    install -d -m 0755 "$(dirname "${EASY_ALL_INSTALL_DIR}")" "$(dirname "${EASY_ALL_COMMAND_PATH}")"
    stage=$(mktemp -d "${EASY_ALL_INSTALL_DIR}.stage.XXXXXX")
    declare -p cleanup_files >/dev/null 2>&1 && cleanup_files+=("${stage}")
    install -m 0755 "${source_root}/easy_all" "${stage}/easy_all"
    install -m 0644 "${source_root}/${EASY_ALL_RUNTIME_MANIFEST}" \
        "${stage}/${EASY_ALL_RUNTIME_MANIFEST}"
    syntax_files=("${stage}/easy_all")
    while IFS= read -r relative_path; do
        install -d -m 0755 "${stage}/$(dirname -- "${relative_path}")"
        install -m 0644 "${source_root}/${relative_path}" \
            "${stage}/${relative_path}"
        [[ "${relative_path}" != *.sh ]] \
            || syntax_files+=("${stage}/${relative_path}")
    done <<<"${paths}"
    bash -n "${syntax_files[@]}" \
        || { rm -rf -- "${stage}"; die "待注册脚本语法校验失败"; }

    rm -rf -- "${backup}"
    [[ ! -d "${EASY_ALL_INSTALL_DIR}" ]] || mv "${EASY_ALL_INSTALL_DIR}" "${backup}"
    if ! mv "${stage}" "${EASY_ALL_INSTALL_DIR}" \
        || ! ln -sfn "${destination}" "${EASY_ALL_COMMAND_PATH}"; then
        rm -rf -- "${EASY_ALL_INSTALL_DIR}"
        [[ ! -d "${backup}" ]] || mv "${backup}" "${EASY_ALL_INSTALL_DIR}"
        die "注册 easy_all 命令失败，已恢复旧版本"
    fi
    rm -rf -- "${backup}"
    success "已注册命令：${EASY_ALL_COMMAND_PATH}"
}

unified_self_update() {
    local target_branch="${EASY_ALL_BRANCH}" temp_dir repo_dir
    require_root
    command -v git >/dev/null 2>&1 || die "缺少 git；请先安装 git 与 ca-certificates"
    case "$#" in
    0) ;;
    1)
        [[ "$1" == "--dev" ]] \
            || die "用法：easy_all self-update [--dev|--branch <分支>]"
        target_branch="dev"
        ;;
    2)
        [[ "$1" == "--branch" && -n "$2" ]] \
            || die "用法：easy_all self-update [--dev|--branch <分支>]"
        target_branch=$2
        ;;
    *) die "用法：easy_all self-update [--dev|--branch <分支>]" ;;
    esac
    git check-ref-format --branch "${target_branch}" >/dev/null 2>&1 \
        || die "无效的 Git 分支：${target_branch}"

    temp_dir=$(make_temp_dir)
    repo_dir="${temp_dir}/easy_all"
    git clone --depth 1 --branch "${target_branch}" "${EASY_ALL_REPOSITORY_URL}" "${repo_dir}" \
        || die "克隆 easy_all 仓库失败"
    [[ -f "${repo_dir}/easy_all" ]] \
        || die "下载的 easy_all 项目缺少入口：easy_all"
    [[ -f "${repo_dir}/${EASY_ALL_RUNTIME_MANIFEST}" ]] \
        || die "下载的 easy_all 项目缺少运行时清单：${EASY_ALL_RUNTIME_MANIFEST}"
    bash -n "${repo_dir}/easy_all" \
        || die "下载的 easy_all 入口语法校验失败"

    chmod 0700 "${repo_dir}/easy_all"
    "${repo_dir}/easy_all" verify-release \
        || die "下载的 easy_all 项目未通过目标版本完整性校验"
    # 注册命令会整体替换运行时目录；与安装、定时任务共用同一把写锁，
    # 避免与正在运行的后台任务交错（它们随后打开的是新版本文件）。
    acquire_runtime_write_lock 30
    "${repo_dir}/easy_all" register-command
    rm -rf -- "${temp_dir}"
    success "easy_all 项目代码已更新；未修改 Xray、Nginx、订阅或云端 CDN 资源"
}

dispatch_profile_command() {
    local mode=$1 command=$2
    shift 2
    case "${command}" in
    install) install_all ;;
    show) require_root; show_node ;;
    subscription) require_root; show_subscription ;;
    apply)
        apply_easy_all
        ;;
    tcp-resume) resume_skyline_after_reboot "$@" ;;
    reality-target)
        [[ "${mode}" == "reality" || "${mode}" == "combined" ]] \
            || launcher_die "reality-target 仅适用于 Reality 与直连+CDN模式"
        update_reality_target "$@"
        ;;
    apply-cloud)
        [[ "${mode}" == "cdn" || "${mode}" == "combined" ]] \
            || launcher_die "apply-cloud 仅适用于纯 CDN 与直连+CDN模式"
        (($# == 0)) || launcher_die "apply-cloud 不接受额外参数"
        apply_cloud_resources
        ;;
    edit-sub)
        if [[ "${mode}" == "reality" ]]; then
            update_subscription 1
        else
            update_subscription
        fi
        ;;
    update-core)
        update_current_core "$@"
        ;;
    refresh-cdn-ips)
        [[ "${mode}" == "cdn" || "${mode}" == "combined" ]] \
            || launcher_die "refresh-cdn-ips 仅适用于纯 CDN 与直连+CDN模式"
        refresh_cdn_ips
        ;;
    renew-cert)
        case "${mode}" in
        reality) renew_subscription_certificate ;;
        cdn | combined) renew_certificate ;;
        *) launcher_die "当前模式不使用 TLS 证书，无需续期" ;;
        esac
        ;;
    rotate-dynamic-ports)
        case "${mode}" in
        reality) rotate_dynamic_ports ;;
        *) launcher_die "rotate-dynamic-ports 仅适用于 Reality 模式" ;;
        esac
        ;;
    status) show_status ;;
    self-update) unified_self_update "$@" ;;
    register-command) register_easy_all_command ;;
    uninstall) uninstall_all "$@" ;;
    help | -h | --help) launcher_usage ;;
    *) launcher_usage; return 1 ;;
    esac
}

main() {
    local command=${1:-install} mode="" module
    shift || true

    if [[ "${command}" == "help" || "${command}" == "-h" || "${command}" == "--help" ]]; then
        launcher_usage
        return
    fi
    if [[ "${command}" == "purge-cloudflare" ]]; then
        bash "${EASY_ALL_ROOT}/lib/cloudflare-purge.sh" "$@"
        exit
    fi
    if [[ "${command}" == "cleanup-partial" ]]; then
        cleanup_partial_install_command "$@"
        exit
    fi
    if [[ "${command}" == "verify-release" ]]; then
        (($# == 0)) || launcher_die "verify-release 不接受参数"
        runtime_tree_is_complete "${EASY_ALL_ROOT}" \
            || launcher_die "easy_all 运行时文件不完整：${EASY_ALL_ROOT}"
        return
    fi

    if [[ "${command}" == "install" ]]; then
        (($# == 0)) || launcher_die "install 不接受参数，请在交互菜单中选择"
        [[ "$(id -u)" -eq 0 ]] || launcher_die "请使用 root 用户运行此脚本"
        mode=$(detect_installed_mode)
        if [[ -n "${mode}" ]]; then
            launcher_die "已安装 ${mode}；一台 VPS 只允许一种模式。如需重新安装请先执行 easy_all uninstall"
        fi
        mode=$(choose_install_mode)
    else
        mode=$(detect_installed_mode)
        [[ -n "${mode}" ]] || launcher_die "easy_all 尚未安装"
    fi

    module=$(profile_file "${mode}")
    export EASY_ALL_SELECTED_MODE="${mode}"
    # shellcheck source=/dev/null
    source "${module}"

    register_easy_all_command() {
        unified_register_easy_all_command
    }
    dispatch_profile_command "${mode}" "${command}" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
