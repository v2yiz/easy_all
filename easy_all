#!/usr/bin/env bash

set -Eeuo pipefail
umask 077
export LANG=C.UTF-8 LC_ALL=C.UTF-8

# Cron commonly starts commands with only /usr/bin:/bin. easy_all also needs
# administrative tools such as ufw and iptables-restore from the sbin paths.
readonly EASY_ALL_SYSTEM_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH="${EASY_ALL_SYSTEM_PATH}${PATH:+:${PATH}}"

EASY_ALL_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${EASY_ALL_SOURCE}" ]]; do
    EASY_ALL_SOURCE_DIR="$(cd -- "$(dirname -- "${EASY_ALL_SOURCE}")" >/dev/null 2>&1 && pwd)"
    EASY_ALL_SOURCE=$(readlink "${EASY_ALL_SOURCE}")
    [[ "${EASY_ALL_SOURCE}" == /* ]] || EASY_ALL_SOURCE="${EASY_ALL_SOURCE_DIR}/${EASY_ALL_SOURCE}"
done
readonly EASY_ALL_ROOT="$(cd -- "$(dirname -- "${EASY_ALL_SOURCE}")" >/dev/null 2>&1 && pwd)"
readonly EASY_ALL_STATE_FILE="${EASY_ALL_STATE_FILE_OVERRIDE:-/etc/easy_all/state.env}"
readonly EASY_ALL_BUNNY_JOURNAL="${BUNNY_JOURNAL:-${BUNNY_RECOVERY_DIR:-/etc/easy_all-bunny}/ownership.json}"
readonly EASY_ALL_INSTALL_DIR="/usr/local/lib/easy_all"
readonly EASY_ALL_COMMAND_PATH="/usr/local/bin/easy_all"
readonly EASY_ALL_REPOSITORY_URL="${EASY_ALL_REPOSITORY_URL_OVERRIDE:-https://github.com/v2yiz/easy_all.git}"
readonly EASY_ALL_DEFAULT_BRANCH="main"
readonly EASY_ALL_BRANCH="${EASY_ALL_BRANCH_OVERRIDE:-${EASY_ALL_BRANCH:-${EASY_ALL_DEFAULT_BRANCH}}}"
readonly EASY_ALL_RUNTIME_MANIFEST="runtime.manifest"
readonly CURRENT_STATE_VERSION="0"
readonly -a EASY_ALL_PRESERVED_RUNTIME_FILES=(
    "fail2ban-ufw-cidr.sh"
)

# 安装参数层：launcher 需要先读参数文件里的 mode 才能选中 Profile。
# shellcheck source=lib/params.sh
source "${EASY_ALL_ROOT}/lib/params.sh"

launcher_die() {
    printf '\033[31m%s\033[0m\n' "$*" >&2
    exit 1
}

strip_launcher_input() {
    local esc=$'\033'
    printf '%s' "$1" | sed -e "s/${esc}\[[0-9;?]*[A-Za-z]//g" -e "s/${esc}O[A-Za-z]//g" \
        | tr -d '\000-\010\013\014\016-\037\177'
}

launcher_read_bilingual() {
    local label=$1 variable=$2 input
    printf '%s\n' "${label}" >&2
    IFS= read -r -e -p '> ' input
    printf -v "${variable}" '%s' "$(strip_launcher_input "${input}")"
}

runtime_manifest_paths() {
    local root=$1 relative_path
    local manifest="${root}/${EASY_ALL_RUNTIME_MANIFEST}"
    [[ -f "${manifest}" ]] || return 1
    while IFS= read -r relative_path || [[ -n "${relative_path}" ]]; do
        relative_path=${relative_path%$'\r'}
        [[ -n "${relative_path}" && "${relative_path}" != \#* ]] || continue
        [[ "${relative_path}" =~ ^[A-Za-z0-9._/-]+$ ]] || return 1
        case "/${relative_path}/" in
        *"/../"* | *"/./"* | *"//"*) return 1 ;;
        esac
        [[ "${relative_path}" != /* ]] || return 1
        printf '%s\n' "${relative_path}"
    done <"${manifest}"
}

runtime_tree_is_complete() {
    local root=$1 relative_path paths
    [[ -f "${root}/easy_all" ]] || return 1
    paths=$(runtime_manifest_paths "${root}") || return 1
    [[ -n "${paths}" ]] || return 1
    while IFS= read -r relative_path; do
        [[ -f "${root}/${relative_path}" ]] || return 1
    done <<<"${paths}"
}

