#!/usr/bin/env bash

set -Eeuo pipefail
umask 077
export LANG=C.UTF-8 LC_ALL=C.UTF-8

# Cron commonly starts commands with only /usr/bin:/bin. easy_all also needs
# administrative tools such as ufw and iptables-restore from the sbin paths.
readonly EASY_ALL_SYSTEM_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH="${EASY_ALL_SYSTEM_PATH}${PATH:+:${PATH}}"

EASY_ALL_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${EASY_ALL_SOURCE}" ]]; do
    EASY_ALL_SOURCE_DIR="$(cd -- "$(dirname -- "${EASY_ALL_SOURCE}")" >/dev/null 2>&1 && pwd)"
    EASY_ALL_SOURCE=$(readlink "${EASY_ALL_SOURCE}")
    [[ "${EASY_ALL_SOURCE}" == /* ]] || EASY_ALL_SOURCE="${EASY_ALL_SOURCE_DIR}/${EASY_ALL_SOURCE}"
done
readonly EASY_ALL_ROOT="$(cd -- "$(dirname -- "${EASY_ALL_SOURCE}")" >/dev/null 2>&1 && pwd)"
readonly EASY_ALL_STATE_FILE="${EASY_ALL_STATE_FILE_OVERRIDE:-/etc/easy_all/state.env}"
readonly EASY_ALL_INSTALL_DIR="/usr/local/lib/easy_all"
readonly EASY_ALL_COMMAND_PATH="/usr/local/bin/easy_all"
readonly EASY_ALL_REPOSITORY_URL="${EASY_ALL_REPOSITORY_URL_OVERRIDE:-https://github.com/v2yiz/easy_all.git}"
readonly EASY_ALL_DEFAULT_BRANCH="main"
readonly EASY_ALL_BRANCH="${EASY_ALL_BRANCH_OVERRIDE:-${EASY_ALL_BRANCH:-${EASY_ALL_DEFAULT_BRANCH}}}"
readonly EASY_ALL_RUNTIME_MANIFEST="runtime.manifest"
readonly CURRENT_STATE_VERSION="0"

# 状态结构必需字段的单一来源：launcher 在加载任何 Profile 之前就需要它做分类。
readonly EASY_ALL_STATE_LIB="${EASY_ALL_ROOT}/lib/cloudfront-state.sh"
readonly EASY_ALL_CLOUDFLARE_STATE_LIB="${EASY_ALL_ROOT}/lib/cloudflare-state.sh"
for state_lib in "${EASY_ALL_STATE_LIB}" "${EASY_ALL_CLOUDFLARE_STATE_LIB}"; do
    [[ -f "${state_lib}" ]] \
        || { printf '\033[31m缺少 easy_all 运行时文件：%s\033[0m\n' "${state_lib}" >&2; exit 1; }
done
unset state_lib
# shellcheck source=lib/cloudfront-state.sh
source "${EASY_ALL_STATE_LIB}"
# shellcheck source=lib/cloudflare-state.sh
source "${EASY_ALL_CLOUDFLARE_STATE_LIB}"


launcher_die() {
    printf '\033[31m%s\033[0m\n' "$*" >&2
    exit 1
}

strip_launcher_input() {
    local esc=$'\033'
    printf '%s' "$1" | sed -e "s/${esc}\[[0-9;?]*[A-Za-z]//g" -e "s/${esc}O[A-Za-z]//g" \
        | tr -d '\000-\010\013\014\016-\037\177'
}

launcher_read_bilingual() {
    local label=$1 variable=$2 input
    printf '%s\n' "${label}" >&2
    IFS= read -r -e -p '> ' input
    printf -v "${variable}" '%s' "$(strip_launcher_input "${input}")"
}

runtime_manifest_paths() {
    local root=$1 relative_path
    local manifest="${root}/${EASY_ALL_RUNTIME_MANIFEST}"
    [[ -f "${manifest}" ]] || return 1
    while IFS= read -r relative_path || [[ -n "${relative_path}" ]]; do
        relative_path=${relative_path%$'\r'}
        [[ -n "${relative_path}" && "${relative_path}" != \#* ]] || continue
        [[ "${relative_path}" =~ ^[A-Za-z0-9._/-]+$ ]] || return 1
        case "/${relative_path}/" in
        *"/../"* | *"/./"* | *"//"*) return 1 ;;
        esac
        [[ "${relative_path}" != /* ]] || return 1
        printf '%s\n' "${relative_path}"
    done <"${manifest}"
}

runtime_tree_is_complete() {
    local root=$1 relative_path paths
    [[ -f "${root}/easy_all" ]] || return 1
    paths=$(runtime_manifest_paths "${root}") || return 1
    [[ -n "${paths}" ]] || return 1
    while IFS= read -r relative_path; do
        [[ -f "${root}/${relative_path}" ]] || return 1
    done <<<"${paths}"
}

launcher_usage() {
    cat <<'EOF'
用法: easy_all [命令]

  install          交互选择安装模式（1 直连 / 2 纯 CloudFront / 3 纯 CloudFlare /
                   4 直连+CloudFront / 5 直连+CloudFlare）
  show             显示当前节点
  subscription     显示节点与订阅信息
  self-update [--dev|--branch <分支>]
                   更新项目代码；默认 main，--dev 使用 dev
  apply            应用已安装配置；CDN 模式只重建本机与订阅（不访问云 API）
  reality-target [域名:端口]
                   修改 Reality SNI（伪装目标）并重新应用
  rotate-dynamic-ports
                   立即刷新直连 Reality 模式的动态端口 NAT 规则
  apply-cloud      同步云端资源（Cloudflare DNS 与 Origin CA、AWS ACM 与 CloudFront 分发）
  edit-sub         交互编辑订阅配置（Token + 聚合节点）与模板
  cdn-traffic-sync 同步 CloudFront CDN 用量并落实流量阻断（仅 CloudFront 模式）
  purge-cloudflare 清理 easy_all 创建的 Cloudflare 资源（可在未安装状态使用）
  update-core      更新当前模式的核心（Xray）
  renew-cert       重新签发/部署当前模式的 TLS 证书
  status           显示运行状态
  cleanup-partial  清理上次中断安装留下的本机残留（未安装状态使用；不改云端资源）
  uninstall        卸载当前模式；可追加 --purge-cloud 清理托管的远端资源
  help             显示帮助

一台 VPS 只能安装一种模式。
EOF
}

# 一次读入 marker 并同时给出「模式/阶段/身份」：模式与身份必须来自同一份快照，
# 否则两次读取之间换了安装，就可能拿着旧模式的身份去比对新模式。
# 输出：absent | present|PROFILE|STAGE|STARTED_AT
launcher_marker_snapshot() {
    local file=${1:-} content profile stage started chain
    if [[ -z "${file}" || ! -f "${file}" ]]; then
        printf 'absent'
        return 0
    fi
    content=$(<"${file}") || { printf 'unreadable'; return 0; }
    profile=$(printf '%s\n' "${content}" | sed -n 's/^PROFILE=//p' | tail -n 1)
    stage=$(printf '%s\n' "${content}" | sed -n 's/^STAGE=//p' | tail -n 1)
    started=$(printf '%s\n' "${content}" | sed -n 's/^STARTED_AT=//p' | tail -n 1)
    chain=$(printf '%s\n' "${content}" | sed -n 's/^CHAIN=//p' | tail -n 1)
    printf 'present|%s|%s|%s|%s' "${profile}" "${stage}" "${started}" "${chain}"
}

# 旧安装标记（PROFILE=cdn，以及没有 CHAIN=cloudfront 的旧 PROFILE=combined）来自已删除的
# 旧 Cloudflare 橙云链路：它们的 Profile 不再存在（combined.sh 已改为模式 3），不能 source。
launcher_marker_is_legacy_cloudflare() {
    local profile=${1:-} chain=${2:-}
    case "${profile}" in
    cdn) return 0 ;;
    combined) [[ "${chain}" != "cloudfront" ]] ;;
    *) return 1 ;;
    esac
}

# 只加载新核心（不加载任何 Profile）：旧标记的固定本机路径、旧 easy_all-cf-origin 回源
# 放行、旧 Globalping 单元与自有 certbot lineage 都由核心的本机清理函数回收。
launcher_source_legacy_cleanup_core() {
    XHTTP_LIB_DIR="${EASY_ALL_ROOT}/lib"
    export XHTTP_LIB_DIR
    # shellcheck source=/dev/null
    source "${XHTTP_LIB_DIR}/xhttp-runtime.sh" || return 1
    # shellcheck source=/dev/null
    source "${XHTTP_LIB_DIR}/cloudfront-mode.sh" || return 1
}

# 上次安装被 SSH 断线打断后，没有状态文件也就没有 uninstall 可用；这条命令是唯一
# 能从本机自救的入口。它只信安装期写入的 marker 来定位模式，不猜测、不动云端资源。
cleanup_partial_install_command() {
    local progress_file mode stage started_at chain answer module
    local snapshot_before snapshot_after legacy=0
    local bootstrap='bash <(curl -fsSL https://raw.githubusercontent.com/v2yiz/easy_all/main/bootstrap.sh)'
    while (($# > 0)); do
        case "$1" in
        -h | --help)
            printf '用法：easy_all cleanup-partial\n'
            printf '  按安装进度标记判断上次中断的模式并清理本机残留。\n'
            return 0
            ;;
        *) launcher_die "用法：easy_all cleanup-partial" ;;
        esac
    done
    [[ "$(id -u)" -eq 0 ]] || launcher_die "请使用 root 用户运行此脚本"
    [[ ! -f "${EASY_ALL_STATE_FILE}" ]] \
        || launcher_die "easy_all 已安装；如需卸载请执行 easy_all uninstall"
    progress_file="${EASY_ALL_INSTALL_PROGRESS_FILE_OVERRIDE:-/var/lib/easy_all/install-progress.env}"
    # 模式、阶段、身份必须来自同一次读取。
    snapshot_before=$(launcher_marker_snapshot "${progress_file}")
    case "${snapshot_before}" in
    absent)
        launcher_die "未检测到安装进度标记；本机没有待清理的 easy_all 安装残留"
        ;;
    unreadable)
        launcher_die "无法读取安装进度标记 ${progress_file}；请检查权限后重试"
        ;;
    esac
    IFS='|' read -r _ mode stage started_at chain <<<"${snapshot_before}"
    [[ -n "${mode}" ]] || launcher_die "安装进度标记缺少模式信息（${progress_file}）；请核对标记内容或人工清理残留后重装"
    if launcher_marker_is_legacy_cloudflare "${mode}" "${chain}"; then
        legacy=1
        printf '检测到未完成的旧 Cloudflare 链路安装（PROFILE=%s，中断于 %s 阶段）；按固定本机路径清理\n' \
            "${mode}" "${stage}" >&2
    else
        profile_file "${mode}" >/dev/null
        printf '检测到未完成的 %s 安装（中断于 %s 阶段）\n' "${mode}" "${stage}" >&2
    fi
    if [[ "${FORCE:-0}" != "1" ]]; then
        [[ -t 0 ]] || launcher_die "非交互清理必须显式设置 FORCE=1"
        launcher_read_bilingual '清理本机残留（不改动 Cloudflare 云端资源）？[y/N]:' answer
        [[ "${answer}" =~ ^[Yy]$ ]] || launcher_die "已取消"
    fi
    if ((legacy == 1)); then
        launcher_source_legacy_cleanup_core || launcher_die "无法加载清理核心；请重新下载 easy_all 后重试"
    else
        module=$(profile_file "${mode}") || exit 1
        export EASY_ALL_SELECTED_MODE="${mode}"
        # shellcheck source=/dev/null
        source "${module}"
    fi
    register_easy_all_command() {
        unified_register_easy_all_command
    }
    acquire_runtime_write_lock 30
    # 等待锁期间安装可能已经成功（状态文件出现），或另一个安装重新写了 marker。
    if [[ -f "${EASY_ALL_STATE_FILE}" ]]; then
        launcher_die "easy_all 已在等待期间完成安装；已取消清理。如确需卸载请执行 easy_all uninstall"
    fi
    # 等锁期间可能出现「标记消失」「无标记 -> 出现新安装标记」「同模式但换了新一次安装」，
    # 任一变化都不能按旧判断继续清理。
    snapshot_after=$(launcher_marker_snapshot "${progress_file}")
    if [[ "${snapshot_after}" != "${snapshot_before}" ]]; then
        launcher_die "等待锁期间安装进度已变化（${snapshot_before} -> ${snapshot_after}）；已取消清理，请确认后在无安装运行时重试"
    fi
    cleanup_partial_install
    # 清理会删掉 easy_all 命令本身，下一步只能用 bootstrap 入口。
    success "本机残留已清理完成；如安装期已创建云端资源，需要时用 ${bootstrap} purge-cloudflare 清理"
}

choose_install_mode() {
    local choice
    [[ -t 0 ]] || launcher_die "安装必须在交互终端中执行"
    printf '请选择安装模式：\n' >&2
    printf '  1. 直连 - Reality（直连效果良好且 IP 未被封时）\n' >&2
    printf '  2. 纯 CloudFront - AWS CloudFront XHTTP（直连不佳、IP 被封或只要 CDN 入口时）\n' >&2
    printf '  3. 纯 CloudFlare - Cloudflare 橙云 XHTTP（单域名同时提供节点与订阅）\n' >&2
    printf '  4. 直连+CloudFront：直连 Reality + CloudFront（一次部署两个入口）\n' >&2
    printf '  5. 直连+CloudFlare：直连 Reality + Cloudflare 橙云 XHTTP\n' >&2
    launcher_read_bilingual '请选择 [1]（直接回车使用默认值）:' choice
    case "${choice:-1}" in
    1) printf 'reality\n' ;;
    2) printf 'cloudfront\n' ;;
    3) printf 'cloudflare\n' ;;
    4) printf 'combined\n' ;;
    5) printf 'combined-cloudflare\n' ;;
    *) launcher_die "不支持的安装模式：${choice}" ;;
    esac
}

state_value() {
    local file=$1 key=$2 line value
    [[ -f "${file}" ]] || return 1
    line=$(grep -E "^${key}=" "${file}" | tail -n 1) || return 1
    value=${line#*=}
    value=${value#\'}
    value=${value%\'}
    value=${value#\"}
    value=${value%\"}
    printf '%s\n' "${value}"
}

# CloudFront 新协议必须字段齐全才允许任何应用操作；缺字段只保留卸载通道。
# 字段清单来自 lib/cloudfront-state.sh（与核心结构校验同一来源，含模式 3 直连字段）。
launcher_cloudfront_state_complete() {
    local file=$1 protocol field value
    protocol=$(state_value "${file}" PROTOCOL || true)
    while IFS= read -r field; do
        value=$(state_value "${file}" "${field}" || true)
        [[ -n "${value}" ]] || return 1
    done < <(cloudfront_state_required_fields "${protocol}")
    [[ "$(state_value "${file}" CDN_PROVIDER)" == "aws" ]] || return 1
    [[ "$(state_value "${file}" CDN_TRAFFIC_PROTECTION_GB)" == "985" ]] || return 1
}

# Cloudflare 橙云链路的结构校验：字段来自 lib/cloudflare-state.sh，没有 AWS 与
# 985GB 熔断字段（橙云链路不计量）。
launcher_cloudflare_state_complete() {
    local file=$1 protocol field value
    protocol=$(state_value "${file}" PROTOCOL || true)
    while IFS= read -r field; do
        value=$(state_value "${file}" "${field}" || true)
        [[ -n "${value}" ]] || return 1
    done < <(cloudflare_state_required_fields "${protocol}")
    [[ "$(state_value "${file}" CDN_PROVIDER)" == "cloudflare" ]] || return 1
}

# 输出既能识别又能门禁的模式分类：
#   reality / cloudfront / combined-cloudfront / cloudflare / combined-cloudflare（新链路）
#   cdn / combined（旧 Cloudflare 链路，仅卸载）
#   incomplete-*（新协议但字段不齐，仅卸载）
detect_installed_mode() {
    local protocol="" state_version=""
    # 不可读的状态文件（目录可搜索、文件 0600 root）同样交给 main 统一提示 root：直接往下
    # 读会把「状态版本不匹配」这类误导信息抛给非 root 用户；root 下 `-r` 恒为真，行为不变。
    if [[ -f "${EASY_ALL_STATE_FILE}" && -r "${EASY_ALL_STATE_FILE}" ]]; then
        protocol=$(state_value "${EASY_ALL_STATE_FILE}" PROTOCOL || true)
        state_version=$(state_value "${EASY_ALL_STATE_FILE}" STATE_VERSION || true)
        [[ "${state_version}" == "${CURRENT_STATE_VERSION}" ]] \
            || launcher_die "状态版本不匹配（当前：${state_version:-缺失}，期望：${CURRENT_STATE_VERSION}）；当前版本无法接管这份状态，请先执行 sudo easy_all uninstall（旧版本状态必要时先用旧 --purge-cloud 清理云端）"
        case "${protocol}" in
        reality)
            printf 'reality\n'
            ;;
        cloudfront)
            if launcher_cloudfront_state_complete "${EASY_ALL_STATE_FILE}"; then
                printf 'cloudfront\n'
            else
                printf 'incomplete-cloudfront\n'
            fi
            ;;
        combined-cloudfront)
            if launcher_cloudfront_state_complete "${EASY_ALL_STATE_FILE}"; then
                printf 'combined-cloudfront\n'
            else
                printf 'incomplete-combined-cloudfront\n'
            fi
            ;;
        cloudflare)
            if launcher_cloudflare_state_complete "${EASY_ALL_STATE_FILE}"; then
                printf 'cloudflare\n'
            else
                printf 'incomplete-cloudflare\n'
            fi
            ;;
        combined-cloudflare)
            if launcher_cloudflare_state_complete "${EASY_ALL_STATE_FILE}"; then
                printf 'combined-cloudflare\n'
            else
                printf 'incomplete-combined-cloudflare\n'
            fi
            ;;
        cdn|combined)
            printf '%s\n' "${protocol}"
            ;;
        *) launcher_die "无法识别已安装协议：${protocol:-缺失}" ;;
        esac
        return
    fi
}

# 状态目录 /etc/easy_all 为 0700：非 root 时 `-f` 同样为假，直接报「尚未安装」会误导用户去重装。
# 只在目录确实不存在（或确认可访问而无状态文件）时报未安装；其余情况交回 root/sudo。
launcher_require_installed_mode() {
    local mode=$1 command=$2 state_dir state_parent
    [[ -z "${mode}" ]] || return 0
    state_dir=$(dirname -- "${EASY_ALL_STATE_FILE}")
    state_parent=$(dirname -- "${state_dir}")
    if [[ -d "${state_dir}" ]]; then
        # 目录可访问且确认没有状态文件：确实未安装。
        [[ -r "${state_dir}" && -x "${state_dir}" && ! -e "${EASY_ALL_STATE_FILE}" ]] \
            && launcher_die "easy_all 尚未安装"
    elif [[ -x "${state_parent}" ]]; then
        # 父目录可搜索时 `-d` 为假才能证明目录不存在。
        launcher_die "easy_all 尚未安装"
    fi
    launcher_die "无法读取安装状态（${EASY_ALL_STATE_FILE}）：当前用户无权访问；若已安装请用 root 运行：sudo easy_all ${command}"
}

profile_file() {
    local mode=$1 candidate
    case "${mode}" in
    reality) candidate="${EASY_ALL_ROOT}/profiles/reality.sh" ;;
    # 旧 PROTOCOL=cdn 只保留卸载通道，复用新核心的本机清理实现。
    cdn) candidate="${EASY_ALL_ROOT}/profiles/cloudfront.sh" ;;
    combined|combined-cloudfront|incomplete-combined-cloudfront)
        candidate="${EASY_ALL_ROOT}/profiles/combined.sh" ;;
    cloudflare|incomplete-cloudflare)
        candidate="${EASY_ALL_ROOT}/profiles/cloudflare.sh" ;;
    combined-cloudflare|incomplete-combined-cloudflare)
        candidate="${EASY_ALL_ROOT}/profiles/combined-cloudflare.sh" ;;
    cloudfront|incomplete-cloudfront) candidate="${EASY_ALL_ROOT}/profiles/cloudfront.sh" ;;
    *) launcher_die "不支持的安装模式：${mode}" ;;
    esac
    [[ -f "${candidate}" ]] || launcher_die "缺少 Profile 模块：${candidate}"
    printf '%s\n' "${candidate}"
}

unified_register_easy_all_command() {
    local source_root=${EASY_ALL_ROOT} destination="${EASY_ALL_INSTALL_DIR}/easy_all"
    local stage backup="${EASY_ALL_INSTALL_DIR}.previous.$$" relative_path paths
    local -a syntax_files
    require_root
    runtime_tree_is_complete "${source_root}" \
        || die "easy_all 运行时文件不完整：${source_root}"
    paths=$(runtime_manifest_paths "${source_root}") \
        || die "easy_all 运行时清单无效：${source_root}/${EASY_ALL_RUNTIME_MANIFEST}"

    install -d -m 0755 "$(dirname "${EASY_ALL_INSTALL_DIR}")" "$(dirname "${EASY_ALL_COMMAND_PATH}")"
    stage=$(mktemp -d "${EASY_ALL_INSTALL_DIR}.stage.XXXXXX")
    declare -p cleanup_files >/dev/null 2>&1 && cleanup_files+=("${stage}")
    install -m 0755 "${source_root}/easy_all" "${stage}/easy_all"
    install -m 0644 "${source_root}/${EASY_ALL_RUNTIME_MANIFEST}" \
        "${stage}/${EASY_ALL_RUNTIME_MANIFEST}"
    syntax_files=("${stage}/easy_all")
    while IFS= read -r relative_path; do
        install -d -m 0755 "${stage}/$(dirname -- "${relative_path}")"
        install -m 0644 "${source_root}/${relative_path}" \
            "${stage}/${relative_path}"
        [[ "${relative_path}" != *.sh ]] \
            || syntax_files+=("${stage}/${relative_path}")
    done <<<"${paths}"
    bash -n "${syntax_files[@]}" \
        || { rm -rf -- "${stage}"; die "待注册脚本语法校验失败"; }

    rm -rf -- "${backup}"
    [[ ! -d "${EASY_ALL_INSTALL_DIR}" ]] || mv "${EASY_ALL_INSTALL_DIR}" "${backup}"
    if ! mv "${stage}" "${EASY_ALL_INSTALL_DIR}" \
        || ! ln -sfn "${destination}" "${EASY_ALL_COMMAND_PATH}"; then
        rm -rf -- "${EASY_ALL_INSTALL_DIR}"
        [[ ! -d "${backup}" ]] || mv "${backup}" "${EASY_ALL_INSTALL_DIR}"
        die "注册 easy_all 命令失败，已恢复旧版本"
    fi
    rm -rf -- "${backup}"
    success "已注册命令：${EASY_ALL_COMMAND_PATH}"
}

unified_self_update() {
    local target_branch="${EASY_ALL_BRANCH}" temp_dir repo_dir
    require_root
    command -v git >/dev/null 2>&1 || die "缺少 git；请先安装 git 与 ca-certificates"
    case "$#" in
    0) ;;
    1)
        [[ "$1" == "--dev" ]] \
            || die "用法：easy_all self-update [--dev|--branch <分支>]"
        target_branch="dev"
        ;;
    2)
        [[ "$1" == "--branch" && -n "$2" ]] \
            || die "用法：easy_all self-update [--dev|--branch <分支>]"
        target_branch=$2
        ;;
    *) die "用法：easy_all self-update [--dev|--branch <分支>]" ;;
    esac
    git check-ref-format --branch "${target_branch}" >/dev/null 2>&1 \
        || die "无效的 Git 分支：${target_branch}"

    temp_dir=$(make_temp_dir)
    repo_dir="${temp_dir}/easy_all"
    git clone --depth 1 --branch "${target_branch}" "${EASY_ALL_REPOSITORY_URL}" "${repo_dir}" \
        || die "克隆 easy_all 仓库失败"
    [[ -f "${repo_dir}/easy_all" ]] \
        || die "下载的 easy_all 项目缺少入口：easy_all"
    [[ -f "${repo_dir}/${EASY_ALL_RUNTIME_MANIFEST}" ]] \
        || die "下载的 easy_all 项目缺少运行时清单：${EASY_ALL_RUNTIME_MANIFEST}"
    bash -n "${repo_dir}/easy_all" \
        || die "下载的 easy_all 入口语法校验失败"

    chmod 0700 "${repo_dir}/easy_all"
    # 克隆落在 mktemp 目录（通常 /tmp）：/tmp 被挂 noexec 时直接执行会 EACCES，必须显式经 bash。
    bash "${repo_dir}/easy_all" verify-release \
        || die "下载的 easy_all 项目未通过目标版本完整性校验"
    # 注册命令会整体替换运行时目录；与安装、定时任务共用同一把写锁，
    # 避免与正在运行的后台任务交错（它们随后打开的是新版本文件）。
    acquire_runtime_write_lock 30
    bash "${repo_dir}/easy_all" register-command
    rm -rf -- "${temp_dir}"
    success "easy_all 项目代码已更新；未修改 Xray、Nginx、订阅或云端 CDN 资源"
}

# 命令参数门禁：只有下列命令带参数，其余一律不接受；未知命令必须先点名，
# 不能只打印 usage。两者都在任何副作用前非零退出。
launcher_command_known() {
    case "$1" in
    install | show | subscription | apply | tcp-resume | reality-target | apply-cloud | edit-sub \
        | update-core | cdn-traffic-sync | renew-cert | rotate-dynamic-ports | status \
        | self-update | register-command | uninstall)
        return 0
        ;;
    *) return 1 ;;
    esac
}

dispatch_validate_arguments() {
    local command=$1
    shift
    case "${command}" in
    uninstall)
        if (($# == 0)); then
            return 0
        fi
        if (($# == 1)) && [[ "$1" == "--purge-cloud" ]]; then
            return 0
        fi
        launcher_die "uninstall 不支持参数：$*（仅接受可选的 --purge-cloud）"
        ;;
    # 既有参数语义保持不变：reality-target [域名:端口]、update-core [参数]、self-update [--dev|--branch <分支>]。
    reality-target | update-core | self-update) return 0 ;;
    *)
        (($# == 0)) || launcher_die "${command} 不接受额外参数"
        ;;
    esac
}

dispatch_profile_command() {
    local mode=$1 command=$2
    shift 2
    if ! launcher_command_known "${command}"; then
        launcher_die "未知命令：${command}"
    fi
    dispatch_validate_arguments "${command}" "$@"
    case "${command}" in
    install) install_all ;;
    show) require_root; show_node ;;
    subscription) require_root; show_subscription ;;
    apply)
        apply_easy_all
        ;;
    tcp-resume) resume_skyline_after_reboot "$@" ;;
    reality-target)
        [[ "${mode}" == "reality" || "${mode}" == "combined-cloudfront" \
            || "${mode}" == "combined-cloudflare" ]] \
            || launcher_die "reality-target 仅适用于 Reality 与直连+CDN 模式"
        update_reality_target "$@"
        ;;
    apply-cloud)
        case "${mode}" in
        cloudfront | combined-cloudfront | cloudflare | combined-cloudflare) ;;
        *) launcher_die "apply-cloud 仅适用于 CDN 模式" ;;
        esac
        apply_cloud_resources
        ;;
    edit-sub)
        if [[ "${mode}" == "reality" ]]; then
            update_subscription 1
        else
            update_subscription
        fi
        ;;
    update-core)
        update_current_core "$@"
        ;;
    cdn-traffic-sync)
        [[ "${mode}" == "cloudfront" || "${mode}" == "combined-cloudfront" ]] \
            || launcher_die "cdn-traffic-sync 仅适用于 CloudFront 模式"
        cdn_traffic_protection_sync
        ;;
    renew-cert)
        case "${mode}" in
        reality) renew_subscription_certificate ;;
        cloudfront | combined-cloudfront | cloudflare | combined-cloudflare) renew_certificate ;;
        *) launcher_die "当前模式不使用 TLS 证书，无需续期" ;;
        esac
        ;;
    rotate-dynamic-ports)
        case "${mode}" in
        reality) rotate_dynamic_ports ;;
        *) launcher_die "rotate-dynamic-ports 仅适用于 Reality 模式" ;;
        esac
        ;;
    status) show_status ;;
    self-update) unified_self_update "$@" ;;
    register-command) register_easy_all_command ;;
    uninstall)
        case "${mode}" in
        cdn | combined) uninstall_legacy_cdn "$@" ;;
        incomplete-cloudfront | incomplete-combined-cloudfront)
            uninstall_incomplete_cloudfront "$@"
            ;;
        incomplete-cloudflare | incomplete-combined-cloudflare)
            uninstall_incomplete_cloudflare "$@"
            ;;
        *) uninstall_all "$@" ;;
        esac
        ;;
    esac
}

main() {
    local command=${1:-install} mode="" module
    shift || true

    if [[ "${command}" == "help" || "${command}" == "-h" || "${command}" == "--help" ]]; then
        launcher_usage
        return
    fi
    if [[ "${command}" == "purge-cloudflare" ]]; then
        bash "${EASY_ALL_ROOT}/lib/cloudflare-purge.sh" "$@"
        exit
    fi
    if [[ "${command}" == "cleanup-partial" ]]; then
        cleanup_partial_install_command "$@"
        exit
    fi
    if [[ "${command}" == "verify-release" ]]; then
        (($# == 0)) || launcher_die "verify-release 不接受参数"
        runtime_tree_is_complete "${EASY_ALL_ROOT}" \
            || launcher_die "easy_all 运行时文件不完整：${EASY_ALL_ROOT}"
        return
    fi

    if [[ "${command}" == "install" ]]; then
        (($# == 0)) || launcher_die "install 不接受参数，请在交互菜单中选择"
        [[ "$(id -u)" -eq 0 ]] || launcher_die "请使用 root 用户运行此脚本"
        mode=$(detect_installed_mode)
        case "${mode}" in
        cdn | combined)
            launcher_die "检测到旧 Cloudflare CDN 安装（PROTOCOL=${mode}）。当前版本不支持接管或迁移；请先执行 sudo easy_all uninstall，再执行 sudo easy_all install 重新选择安装模式。默认卸载保留云端资源。"
            ;;
        incomplete-cloudfront | incomplete-combined-cloudfront)
            launcher_die "CloudFront 状态不完整或来自未完成实现；当前版本不能安全接管。请先执行 sudo easy_all uninstall 后重新安装。"
            ;;
        incomplete-cloudflare | incomplete-combined-cloudflare)
            launcher_die "Cloudflare 状态不完整或来自未完成实现；当前版本不能安全接管。请先执行 sudo easy_all uninstall 后重新安装。"
            ;;
        esac
        if [[ -n "${mode}" ]]; then
            launcher_die "已安装 ${mode}；一台 VPS 只允许一种模式。如需重新安装请先执行 easy_all uninstall"
        fi
        mode=$(choose_install_mode)
    else
        mode=$(detect_installed_mode)
        launcher_require_installed_mode "${mode}" "${command}"
        case "${mode}" in
        cdn | combined)
            [[ "${command}" == "uninstall" ]] \
                || launcher_die "检测到旧 Cloudflare CDN 安装（PROTOCOL=${mode}）。当前版本不支持接管或迁移；请先执行 sudo easy_all uninstall，再执行 sudo easy_all install 重新选择安装模式。默认卸载保留云端资源。"
            ;;
        incomplete-cloudfront | incomplete-combined-cloudfront)
            [[ "${command}" == "uninstall" ]] \
                || launcher_die "CloudFront 状态不完整或来自未完成实现；当前版本不能安全接管。请先执行 sudo easy_all uninstall 后重新安装。"
            ;;
        incomplete-cloudflare | incomplete-combined-cloudflare)
            [[ "${command}" == "uninstall" ]] \
                || launcher_die "Cloudflare 状态不完整或来自未完成实现；当前版本不能安全接管。请先执行 sudo easy_all uninstall 后重新安装。"
            ;;
        esac
    fi

    module=$(profile_file "${mode}")
    export EASY_ALL_SELECTED_MODE="${mode}"
    # shellcheck source=/dev/null
    source "${module}"

    register_easy_all_command() {
        unified_register_easy_all_command
    }
    dispatch_profile_command "${mode}" "${command}" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
