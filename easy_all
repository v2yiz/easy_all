state_value() {
    local file=$1 key=$2 line value
    [[ -f "${file}" ]] || return 1
    line=$(grep -E "^${key}=" "${file}" | tail -n 1) || return 1
    value=${line#*=}
    value=${value#\'}
    value=${value%\'}
    value=${value#\"}
    value=${value%\"}
    printf '%s\n' "${value}"
}

detect_installed_mode() {
    local protocol="" state_version=""
    if [[ -f "${EASY_ALL_STATE_FILE}" ]]; then
        protocol=$(state_value "${EASY_ALL_STATE_FILE}" PROTOCOL || true)
        state_version=$(state_value "${EASY_ALL_STATE_FILE}" STATE_VERSION || true)
        case "${protocol}" in
        reality)
            [[ "${state_version}" == "6" ]] || launcher_die "Reality 状态版本无效；仅支持当前全新安装生成的状态"
            printf 'reality\n'
            ;;
        xhttp | ws)
            [[ "${state_version}" == "7" ]] || launcher_die "XHTTP 状态版本无效；仅支持当前全新安装生成的状态"
            case "$(state_value "${EASY_ALL_STATE_FILE}" CDN_PROVIDER || true)" in
            cloudflare)
                if [[ "$(state_value "${EASY_ALL_STATE_FILE}" BACKEND || true)" == "singbox" ]]; then
                    printf 'singbox-cloudflare\n'
                else
                    printf 'cloudflare\n'
                fi
                ;;
            gcore)
                if [[ "$(state_value "${EASY_ALL_STATE_FILE}" BACKEND || true)" == "singbox" ]]; then
                    printf 'singbox-gcore\n'
                else
                    printf 'gcore\n'
                fi
                ;;
            *) launcher_die "无法识别 CDN Provider：$(state_value "${EASY_ALL_STATE_FILE}" CDN_PROVIDER || true)" ;;
            esac
            ;;
        singbox-ws)
            [[ "${state_version}" == "7" ]] || launcher_die "Sing-box 状态版本无效；仅支持当前全新安装生成的状态"
            printf 'singbox-gcore\n'
            ;;
        singbox-cf)
            [[ "${state_version}" == "7" ]] || launcher_die "Sing-box 状态版本无效；仅支持当前全新安装生成的状态"
            printf 'singbox-cloudflare\n'
            ;;
        *) launcher_die "无法识别已安装协议：${protocol:-缺失}" ;;
        esac
        return
    fi
}

choose_install_mode() {
    local choice
    [[ -t 0 ]] || launcher_die "安装必须在交互终端中执行"
    printf '请选择安装模式：\n' >&2
    printf 'Choose the installation mode:\n' >&2
    printf '  1. 直连 - Reality（优化线路推荐）\n' >&2
    printf '     Direct - Reality (recommended for optimized routes)\n' >&2
    printf '  2. Cloudflare CDN 精选 IP - XHTTP + WebSocket（三网独立优选 + 双链路）\n' >&2
    printf '     Cloudflare CDN optimized IPv4 - XHTTP + WebSocket (3-carrier separated + dual-link)\n' >&2
    printf '  3. Gcore CDN 域名 - XHTTP + WebSocket（Gcore DNS 调度，不做 IP 精选）\n' >&2
    printf '     Gcore CDN domain - XHTTP + WebSocket (Gcore DNS routing, no IP selection)\n' >&2
    printf '  4. Gcore CDN 域名 - Sing-box（Trojan + VLESS WS 双链路，iPhone 推荐，自带两节点自动切换）\n' >&2
    printf '     Gcore CDN domain - Sing-box (dual links, recommended for iPhone, auto failover)\n' >&2
    printf '  5. Cloudflare CDN 精选 IP - Sing-box（VLESS-WS + VLESS-gRPC 双链路，精选 8 节点）\n' >&2
    printf '     Cloudflare CDN optimized IPv4 - Sing-box (VLESS-WS + VLESS-gRPC, 8 optimized nodes)\n' >&2
    launcher_read_bilingual \
        '请选择 [1]（直接回车使用默认值）:' \
        'Choose [1] (press Enter to use the default):' choice
    case "${choice:-1}" in
    1) printf 'reality\n' ;;
    2) printf 'cloudflare\n' ;;
    3) printf 'gcore\n' ;;
    4) printf 'singbox-gcore\n' ;;
    5) printf 'singbox-cloudflare\n' ;;
    *) launcher_die "无效选择：${choice}" ;;
    esac
}

profile_file() {
    local mode=$1 candidate
    case "${mode}" in
    reality) candidate="${EASY_ALL_ROOT}/profiles/reality.sh" ;;
    cloudflare) candidate="${EASY_ALL_ROOT}/profiles/xhttp-cloudflare.sh" ;;
    gcore) candidate="${EASY_ALL_ROOT}/profiles/xhttp-gcore.sh" ;;
    singbox-gcore) candidate="${EASY_ALL_ROOT}/profiles/singbox-gcore.sh" ;;
    singbox-cloudflare) candidate="${EASY_ALL_ROOT}/profiles/singbox-cloudflare.sh" ;;
    *) launcher_die "不支持的安装模式：${mode}" ;;
    esac
    [[ -f "${candidate}" ]] || launcher_die "缺少 Profile 模块：${candidate}"
    printf '%s\n' "${candidate}"
}

stage_preserved_runtime_files() {
    local current_dir=$1 stage_dir=$2 relative_path
    for relative_path in "${EASY_ALL_PRESERVED_RUNTIME_FILES[@]}"; do
        [[ -f "${current_dir}/${relative_path}" ]] || continue
        install -m 0755 "${current_dir}/${relative_path}" \
            "${stage_dir}/${relative_path}"
    done
}

unified_register_easy_all_command() {
    local source_root=${EASY_ALL_ROOT} destination="${EASY_ALL_INSTALL_DIR}/easy_all"
    local stage backup="${EASY_ALL_INSTALL_DIR}.previous.$$" relative_path
    local -a syntax_files
    require_root
    runtime_tree_is_complete "${source_root}" \
        || die "easy_all 运行时文件不完整：${source_root}"

    install -d -m 0755 "$(dirname "${EASY_ALL_INSTALL_DIR}")" "$(dirname "${EASY_ALL_COMMAND_PATH}")"
    stage=$(mktemp -d "${EASY_ALL_INSTALL_DIR}.stage.XXXXXX")
    install -d -m 0755 "${stage}/lib" "${stage}/profiles" "${stage}/templates"
    install -m 0755 "${source_root}/easy_all" "${stage}/easy_all"
    syntax_files=("${stage}/easy_all")
    for relative_path in "${EASY_ALL_RUNTIME_MODULES[@]}"; do
        install -m 0644 "${source_root}/${relative_path}" \
            "${stage}/${relative_path}"
        syntax_files+=("${stage}/${relative_path}")
    done
    [[ ! -f "${source_root}/templates/mihomo.yaml" ]] \
        || install -m 0644 "${source_root}/templates/mihomo.yaml" \
            "${stage}/templates/mihomo.yaml"
    stage_preserved_runtime_files "${EASY_ALL_INSTALL_DIR}" "${stage}"
    bash -n "${syntax_files[@]}" \
        || { rm -rf -- "${stage}"; die "待注册脚本语法校验失败"; }

    rm -rf -- "${backup}"
    [[ ! -d "${EASY_ALL_INSTALL_DIR}" ]] || mv "${EASY_ALL_INSTALL_DIR}" "${backup}"
    if ! mv "${stage}" "${EASY_ALL_INSTALL_DIR}" \
        || ! ln -sfn "${destination}" "${EASY_ALL_COMMAND_PATH}"; then
        rm -rf -- "${EASY_ALL_INSTALL_DIR}"
        [[ ! -d "${backup}" ]] || mv "${backup}" "${EASY_ALL_INSTALL_DIR}"
        die "注册 easy_all 命令失败，已恢复旧版本"
    fi
    rm -rf -- "${backup}"
    success "已注册命令：${EASY_ALL_COMMAND_PATH}"
}

unified_self_update() {
    local target_branch=${1:-${EASY_ALL_BRANCH}}
    local temp_dir repo_dir
    require_root
    command -v git >/dev/null 2>&1 || die "缺少 git；请先安装 git 与 ca-certificates"

    temp_dir=$(make_temp_dir)
    repo_dir="${temp_dir}/easy_all"
    git clone --depth 1 --branch "${target_branch}" "${EASY_ALL_REPOSITORY_URL}" "${repo_dir}" \
        || die "克隆 easy_all 仓库失败"
    [[ -f "${repo_dir}/templates/mihomo.yaml" ]] \
        && runtime_tree_is_complete "${repo_dir}" \
        || die "下载的 easy_all 项目不完整"

    chmod 0700 "${repo_dir}/easy_all"
    "${repo_dir}/easy_all" register-command
    rm -rf -- "${temp_dir}"
    success "easy_all 项目代码已更新；未修改 Xray、Nginx、订阅或云端 CDN 资源"
}

dispatch_profile_command() {
    local mode=$1 command=$2
    shift 2
    case "${command}" in
    install) install_all ;;
    show) require_root; show_node ;;
    subscription) require_root; show_subscription ;;
    apply)
        apply_easy_all
        ;;
    apply-cloud)
        [[ "${mode}" == "cloudflare" || "${mode}" == "gcore" || "${mode}" == "singbox-gcore" || "${mode}" == "singbox-cloudflare" ]] \
            || launcher_die "apply-cloud 仅适用于 CDN 模式"
        apply_cloud_resources
        ;;
    update-sub)
        if [[ "${mode}" == "reality" ]]; then
            update_subscription 1
        else
            update_subscription
        fi
        ;;
    update-core)
        if [[ "${mode}" == "singbox-gcore" || "${mode}" == "singbox-cloudflare" ]]; then
            update_singbox_core
        else
            update_current_core
        fi
        ;;
    refresh-cdn-ips)
        [[ "${mode}" == "cloudflare" || "${mode}" == "singbox-cloudflare" ]] \
            || launcher_die "refresh-cdn-ips 仅适用于 Cloudflare CDN 精选 IP"
        refresh_cloudflare_cdn_ips
        ;;
    cdn-traffic-sync)
        [[ "${mode}" == "gcore" || "${mode}" == "singbox-gcore" ]] \
            || launcher_die "cdn-traffic-sync 仅适用于 Gcore CDN 模式"
        if [[ "${mode}" == "singbox-gcore" ]]; then
            info "当前为 Sing-box 后端模式；全局费用保护定时器已在后端切换时自动停用"
            return 0
        fi
        cdn_traffic_protection_sync
        ;;
    renew-cert)
        if [[ "${mode}" == "reality" ]]; then
            renew_subscription_certificate
        else
            renew_certificate
        fi
        ;;
    rotate-dynamic-ports)
        [[ "${mode}" == "reality" ]] \
            || launcher_die "rotate-dynamic-ports 仅适用于 Reality 模式"
        rotate_dynamic_ports
        ;;
    quota-sync)
        if [[ "${mode}" == "singbox-gcore" || "${mode}" == "singbox-cloudflare" ]]; then
            info "当前为 Sing-box 后端模式；配额统计已停用"
            return 0
        fi
        quota_sync_usage
        ;;
    quota-status)
        require_root
        collect_installed_state
        if [[ "${mode}" == "singbox-gcore" || "${mode}" == "singbox-cloudflare" ]]; then
            info "当前为 Sing-box 后端模式；用户流量配额功能适用于 Xray 后端"
            return 0
        fi
        show_quota_status
        ;;
    quota-set) quota_set_user "$@" ;;
    quota-reset) quota_reset_user "$@" ;;
    status) show_status ;;
    self-update) unified_self_update "$@" ;;
    register-command) register_easy_all_command ;;
    uninstall) uninstall_all "$@" ;;
    help | -h | --help) usage ;;
    *) usage; return 1 ;;
    esac
}

main() {
    local command=${1:-install} mode="" module
    shift || true

    if [[ "${command}" == "help" || "${command}" == "-h" || "${command}" == "--help" ]]; then
        launcher_usage
        return
    fi

    if [[ "${command}" == "switch-backend" ]]; then
        mode=$(detect_installed_mode)
        [[ -n "${mode}" ]] || launcher_die "easy_all 尚未安装"
        if [[ "${mode}" == "gcore" ]]; then
            module=$(profile_file "singbox-gcore")
            export EASY_ALL_SELECTED_MODE="singbox-gcore"
            [[ ! -f "${EASY_ALL_ROOT}/templates/mihomo.yaml" ]] \
                || export MIHOMO_TEMPLATE_SOURCE="${EASY_ALL_ROOT}/templates/mihomo.yaml"
            # shellcheck source=/dev/null
            source "${module}"
            register_easy_all_command() {
                unified_register_easy_all_command
            }
            migrate_from_xhttp_gcore
            return 0
        elif [[ "${mode}" == "singbox-gcore" ]]; then
            module=$(profile_file "gcore")
            export EASY_ALL_SELECTED_MODE="gcore"
            [[ ! -f "${EASY_ALL_ROOT}/templates/mihomo.yaml" ]] \
                || export MIHOMO_TEMPLATE_SOURCE="${EASY_ALL_ROOT}/templates/mihomo.yaml"
            # shellcheck source=/dev/null
            source "${module}"
            register_easy_all_command() {
                unified_register_easy_all_command
            }
            migrate_from_singbox_gcore
            return 0
        elif [[ "${mode}" == "cloudflare" ]]; then
            module=$(profile_file "singbox-cloudflare")
            export EASY_ALL_SELECTED_MODE="singbox-cloudflare"
            [[ ! -f "${EASY_ALL_ROOT}/templates/mihomo.yaml" ]] \
                || export MIHOMO_TEMPLATE_SOURCE="${EASY_ALL_ROOT}/templates/mihomo.yaml"
            # shellcheck source=/dev/null
            source "${module}"
            register_easy_all_command() {
                unified_register_easy_all_command
            }
            migrate_from_xhttp_cloudflare
            return 0
        elif [[ "${mode}" == "singbox-cloudflare" ]]; then
            launcher_die "从 Cloudflare Sing-box 切回 Xray 请先备份配置或重新执行安装"
        else
            launcher_die "switch-backend 仅适用于 Gcore 模式"
        fi
    fi

    if [[ "${command}" == "install" ]]; then
        (($# == 0)) || launcher_die "install 不接受协议参数，请在交互菜单中选择"
        mode=$(detect_installed_mode)
        if [[ -n "${mode}" ]]; then
            if [[ "${mode}" == "gcore" || "${mode}" == "singbox-gcore" ]]; then
                show_install_guide
                local target_mode
                target_mode=$(choose_install_mode)
                if [[ "${mode}" == "gcore" && "${target_mode}" == "singbox-gcore" ]]; then
                    module=$(profile_file "singbox-gcore")
                    export EASY_ALL_SELECTED_MODE="singbox-gcore"
                    [[ ! -f "${EASY_ALL_ROOT}/templates/mihomo.yaml" ]] \
                        || export MIHOMO_TEMPLATE_SOURCE="${EASY_ALL_ROOT}/templates/mihomo.yaml"
                    # shellcheck source=/dev/null
                    source "${module}"
                    register_easy_all_command() {
                        unified_register_easy_all_command
                    }
                    migrate_from_xhttp_gcore
                    return 0
                elif [[ "${mode}" == "singbox-gcore" && "${target_mode}" == "gcore" ]]; then
                    module=$(profile_file "gcore")
                    export EASY_ALL_SELECTED_MODE="gcore"
                    [[ ! -f "${EASY_ALL_ROOT}/templates/mihomo.yaml" ]] \
                        || export MIHOMO_TEMPLATE_SOURCE="${EASY_ALL_ROOT}/templates/mihomo.yaml"
                    # shellcheck source=/dev/null
                    source "${module}"
                    register_easy_all_command() {
                        unified_register_easy_all_command
                    }
                    migrate_from_singbox_gcore
                    return 0
                elif [[ "${mode}" == "${target_mode}" ]]; then
                    launcher_die "已安装 ${mode}；请使用 easy_all apply 刷新配置"
                else
                    launcher_die "已安装 ${mode}；切换到不同平台请先执行 easy_all uninstall"
                fi
            elif [[ "${mode}" == "cloudflare" || "${mode}" == "singbox-cloudflare" ]]; then
                show_install_guide
                local target_mode
                target_mode=$(choose_install_mode)
                if [[ "${mode}" == "cloudflare" && "${target_mode}" == "singbox-cloudflare" ]]; then
                    module=$(profile_file "singbox-cloudflare")
                    export EASY_ALL_SELECTED_MODE="singbox-cloudflare"
                    [[ ! -f "${EASY_ALL_ROOT}/templates/mihomo.yaml" ]] \
                        || export MIHOMO_TEMPLATE_SOURCE="${EASY_ALL_ROOT}/templates/mihomo.yaml"
                    # shellcheck source=/dev/null
                    source "${module}"
                    register_easy_all_command() {
                        unified_register_easy_all_command
                    }
                    migrate_from_xhttp_cloudflare
                    return 0
                elif [[ "${mode}" == "${target_mode}" ]]; then
                    launcher_die "已安装 ${mode}；请使用 easy_all apply 刷新配置"
                else
                    launcher_die "已安装 ${mode}；切换到不同平台请先执行 easy_all uninstall"
                fi
            else
                launcher_die "已安装 ${mode}；一台 VPS 只允许一种模式"
            fi
        fi
        show_install_guide
        mode=$(choose_install_mode)
    else
        mode=$(detect_installed_mode)
        [[ -n "${mode}" ]] || launcher_die "easy_all 尚未安装"
    fi

    module=$(profile_file "${mode}")
    export EASY_ALL_SELECTED_MODE="${mode}"
    [[ ! -f "${EASY_ALL_ROOT}/templates/mihomo.yaml" ]] \
        || export MIHOMO_TEMPLATE_SOURCE="${EASY_ALL_ROOT}/templates/mihomo.yaml"
    # shellcheck source=/dev/null
    source "${module}"

    register_easy_all_command() {
        unified_register_easy_all_command
    }
    dispatch_profile_command "${mode}" "${command}" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
