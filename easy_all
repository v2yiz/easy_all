  4 | gcore                Gcore CDN 精选 IP
  5 | combined             组合：直连 Reality + Cloudflare + Gcore

一台 VPS 只能安装一种模式。
EOF
}

legacy_local_uninstall() {
    local marker
    for marker in "$@"; do
        [[ "${marker}" != "--purge-cloud" ]] \
            || launcher_die "旧状态版本无法安全识别云端资源；已停止卸载，请先在控制台核对 Cloudflare/Gcore/Bunny 资源"
    done
    [[ "$(id -u)" -eq 0 ]] || launcher_die "请使用 root 用户运行此脚本"
    warn "检测到旧版本状态文件；只清理 easy_all 本机文件，SSH 配置、UFW 规则与云端资源保持不变"
    systemctl disable --now easy_all-xray.service easy_all-quota.timer \
        easy_all-globalping-refresh.timer easy_all-bunny-ips.timer \
        easy_all-cert-renew.timer >/dev/null 2>&1 || true
    systemctl stop easy_all-quota.service easy_all-globalping-refresh.service \
        easy_all-bunny-ips.service easy_all-cert-renew.service \
        easy_all-skyline-setup.service >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/easy_all*.service /etc/systemd/system/easy_all*.timer
    if command -v nginx >/dev/null 2>&1; then
        rm -f /etc/nginx/conf.d/easy_all.conf
        nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
    fi
    if crontab -l >/dev/null 2>&1; then
        crontab -l | grep -v 'easy_all-' | crontab - >/dev/null 2>&1 || true
    fi
    rm -rf /etc/easy_all /etc/easy_all-bunny /var/www/easy_all /usr/local/lib/easy_all
    rm -f "${EASY_ALL_COMMAND_PATH}"
    systemctl daemon-reload >/dev/null 2>&1 || true
    warn "本机文件已清理。以下内容需要你自行核对：SSH 端口 drop-in 与 UFW 放行、"
    warn "/etc/fail2ban/{jail.d/99-easy-all-sshd.local,action.d/easy-all-ufw-cidr.conf}、以及云端 CDN/DNS 资源"
    success "旧版本 easy_all 本机清理完成，可以重新安装"
}

# --assume-mode 接受用户最容易输入的写法：菜单序号、中文名与常见缩写。
launcher_mode_alias() {
    case "${1:-}" in
    1 | reality | Reality | 直连) printf 'reality' ;;
    2 | cloudflare | Cloudflare | cloudflare-streamup | cf | CF | xhttp) printf 'cloudflare-streamup' ;;
    3 | bunny | Bunny | bunny-ws) printf 'bunny-ws' ;;
    4 | gcore | Gcore | GCore) printf 'gcore' ;;
    5 | combined | Combined | 组合) printf 'combined' ;;
    *) return 1 ;;
    esac
}

launcher_mode_usage() {
    printf '1|reality 2|cloudflare-streamup 3|bunny-ws 4|gcore 5|combined（也接受 直连/组合/cf 等写法）'
}

# 一次读入 marker 并同时给出「模式/阶段/身份」：模式与身份必须来自同一份快照，
# 否则两次读取之间换了安装，就可能拿着旧模式的身份去比对新模式。
# 输出：absent | present|PROFILE|STAGE|STARTED_AT
launcher_marker_snapshot() {
    local file=${1:-} content profile stage started
    if [[ -z "${file}" || ! -f "${file}" ]]; then
        printf 'absent'
        return 0
    fi
    content=$(<"${file}") || { printf 'unreadable'; return 0; }
    profile=$(printf '%s\n' "${content}" | sed -n 's/^PROFILE=//p' | tail -n 1)
    stage=$(printf '%s\n' "${content}" | sed -n 's/^STAGE=//p' | tail -n 1)
    started=$(printf '%s\n' "${content}" | sed -n 's/^STARTED_AT=//p' | tail -n 1)
    printf 'present|%s|%s|%s' "${profile}" "${stage}" "${started}"
}

# 上次安装被 SSH 断线打断后，没有状态文件也就没有 uninstall 可用；这条命令是唯一
# 能从本机自救的入口。它只信安装期写入的 marker 来定位模式，不猜测、不动云端资源。
cleanup_partial_install_command() {
    local progress_file mode stage started_at answer module assume_mode=""
    local snapshot_before snapshot_after
    local bootstrap='bash <(curl -fsSL https://raw.githubusercontent.com/v2yiz/easy_all/main/bootstrap.sh)'
    while (($# > 0)); do
        case "$1" in
        --assume-mode)
            (($# >= 2)) || launcher_die "用法：easy_all cleanup-partial [--assume-mode <模式>]"
            assume_mode=$2
            shift 2
            ;;
        -h | --help)
            printf '用法：easy_all cleanup-partial [--assume-mode <模式>]\n'
            printf '  可用写法：%s\n' "$(launcher_mode_usage)"
            printf '  无参数：按安装进度标记自动判断模式；旧版本没有标记时用 --assume-mode 指定。\n'
            return 0
            ;;
        *) launcher_die "用法：easy_all cleanup-partial [--assume-mode <模式>]" ;;
        esac
    done
    if [[ -n "${assume_mode}" ]]; then
        local normalized_mode
        normalized_mode=$(launcher_mode_alias "${assume_mode}") \
            || launcher_die "不支持的安装模式：${assume_mode}；可用写法：$(launcher_mode_usage)"
        assume_mode=${normalized_mode}
        profile_file "${assume_mode}" >/dev/null
    fi
    [[ "$(id -u)" -eq 0 ]] || launcher_die "请使用 root 用户运行此脚本"
    [[ ! -f "${EASY_ALL_STATE_FILE}" ]] \
        || launcher_die "easy_all 已安装；如需卸载请执行 easy_all uninstall"
    progress_file="${EASY_ALL_INSTALL_PROGRESS_FILE_OVERRIDE:-/var/lib/easy_all/install-progress.env}"
    # 模式、阶段、身份必须来自同一次读取。
    snapshot_before=$(launcher_marker_snapshot "${progress_file}")
    if [[ "${snapshot_before}" == "absent" ]]; then
        # 旧版本没有进度标记：只有用户明确指定模式时才敢于清理，绝不猜测。
        [[ -n "${assume_mode}" ]] || launcher_die \
            "未检测到安装进度标记，无法判断残留属于哪个模式。先核对 /etc/easy_all、/etc/nginx/conf.d/easy_all.conf 与 easy_all* 服务，再指定模式：${bootstrap} cleanup-partial --assume-mode <模式>；可用写法：$(launcher_mode_usage)"
        mode=${assume_mode}
        stage=""
    elif [[ "${snapshot_before}" == "unreadable" ]]; then
        launcher_die "无法读取安装进度标记 ${progress_file}；请检查权限后重试（或用 --assume-mode 指定模式）"
    else
        IFS='|' read -r _ mode stage started_at <<<"${snapshot_before}"
        [[ -n "${mode}" ]] || launcher_die \
            "安装进度标记缺少模式信息（${progress_file}）；可改用 --assume-mode 指定后清理"
        if [[ -n "${assume_mode}" && "${assume_mode}" != "${mode}" ]]; then
            launcher_die "进度标记显示上次是 ${mode} 模式，与 --assume-mode ${assume_mode} 不一致；请先核对后再决定"
        fi
    fi
    profile_file "${mode}" >/dev/null
    if [[ -z "${stage}" ]]; then
        printf '没有安装进度标记；按你指定的 %s 模式清理残留\n' "${mode}" >&2
    else
        printf '检测到未完成的 %s 安装（中断于 %s 阶段）\n' "${mode}" "${stage}" >&2
    fi
    if [[ "${FORCE:-0}" != "1" ]]; then
        [[ -t 0 ]] || launcher_die "非交互清理必须显式设置 FORCE=1"
        launcher_read_bilingual '清理本机残留（不改动 Cloudflare/Gcore/Bunny 云端资源）？[y/N]:' answer
        [[ "${answer}" =~ ^[Yy]$ ]] || launcher_die "已取消"
    fi
    module=$(profile_file "${mode}") || exit 1
    export EASY_ALL_SELECTED_MODE="${mode}"
    # shellcheck source=/dev/null
    source "${module}"
    register_easy_all_command() {
        unified_register_easy_all_command
    }
    acquire_runtime_write_lock 30
    # 等待锁期间安装可能已经成功（状态文件出现），或另一个安装重新写了 marker。
    if [[ -f "${EASY_ALL_STATE_FILE}" ]]; then
        launcher_die "easy_all 已在等待期间完成安装；已取消清理。如确需卸载请执行 easy_all uninstall"
    fi
    # 等锁期间可能出现「标记消失」「无标记 -> 出现新安装标记」「同模式但换了新一次安装」，
    # 任一变化都不能按旧判断继续清理。
    snapshot_after=$(launcher_marker_snapshot "${progress_file}")
    if [[ "${snapshot_after}" != "${snapshot_before}" ]]; then
        launcher_die "等待锁期间安装进度已变化（${snapshot_before} -> ${snapshot_after}）；已取消清理，请确认后在无安装运行时重试"
    fi
    cleanup_partial_install
    # 清理会删掉 easy_all 命令本身，下一步只能用 bootstrap 入口。
    success "本机残留已清理完成；如安装期已创建云端资源，需要时用 ${bootstrap} purge-cloudflare / purge-gcore 清理"
}

show_install_guide() {
    cat >&2 <<'EOF'
安装流程概览：
easy_all install
├─ [1 默认] 直连 Reality
│  ├─ 适用场景：直连效果良好，且 VPS 公网 IP 未被封锁
│  ├─ 系统检查 → 依赖/TCP 加速（默认 Skyline Speeder）/重启策略 → 全局禁用 IPv6
│  ├─ IPv4 连接地址（默认自动探测公网 IPv4）→ SNI → 订阅端口
│  ├─ 选择订阅输出（默认不部署订阅）
│  │  ├─ 1 仅节点：不收集订阅服务参数
│  │  ├─ 2 本机订阅：Cloudflare 一级子域名、Origin CA、文件名、Token/配额
│  │  └─ 3 Worker 聚合：公开订阅域名、私有节点源域名、Worker 名称、
│  │     可选聚合 JSON（另外两台节点）、Token/配额
│  ├─ 下载 Xray → UFW（8443 仅允许 Cloudflare 回源）→ 安装并验收 Xray
│  └─ 应用已选订阅输出 → 保存最终状态 → 注册命令/配额任务
├─ [2] Cloudflare CDN 精选 IP - 纯 XHTTP stream-up（6 个 IPv4）
│  ├─ 适用场景：直连效果不佳、VPS 公网 IP 已被封，或明确追求 Cloudflare CDN 纯 XHTTP
│  ├─ 前提条件：域名需已接入 Cloudflare 完整托管 Zone
│  ├─ 流量口径：实时回源；VPS 仅计出站时，月度出站额度通常是代理载荷的主要上限（并非严格等值）
│  ├─ 入口 IP 族：固定 IPv4，输出 6 个三网精选节点
│  ├─ VPS、Xray 与客户端统一固定 IPv4
│  ├─ 采用 Xray 服务端后端，运行纯 VLESS XHTTP stream-up 极速流模式
│  ├─ 全网综合优选：Globalping 三网验证 6 个 IPv4
│  ├─ 6 个 XHTTP 节点使用 AUTO 组；可选纯 Worker 节点使用 🇭🇰CF 自动测速组
│  ├─ 订阅服务：Worker 为唯一公开聚合入口，Nginx 只提供私有动态节点源
│  ├─ Worker 名称可指定（默认 easyall），订阅域名必须与节点域名不同
│  ├─ 可选输入不含 vpsSubUrl 的 Worker 聚合 JSON；本机注入源 URL 后构建 Worker
│  ├─ 订阅输出：一条订阅链接，按客户端自动下发 Mihomo YAML 或 Base64（`flag=` 可强制）
│  └─ 零损失就地平滑安装/迁移
├─ [3] Bunny CDN（VLESS WS/TLS + Cloudflare DNS-only CNAME + 保留 Nginx）
│  ├─ 前提条件：Cloudflare 根 Zone、两个不同域名、Bunny Account API Key 与 Zone DNS Token
│  ├─ DNS：origin 为 DNS-only A、cdn 为 DNS-only CNAME；不创建 Bunny DNS Zone/NS 委派
│  ├─ 数据面：Bunny 终止客户端 TLS，Nginx 仅接受官方回源 IPv4 和随机回源头
│  └─ 输出：一个自动调度域名节点及一个 owner 订阅
├─ [4] Gcore CDN 精选 IP - 多地区真实入口（三网定向 1～6 个已验证节点，通常为 2 个）
│  ├─ 适用场景：直连效果不佳、VPS 公网 IP 已被封，或追求 Gcore CDN 边缘与三网定向
│  ├─ 前提条件：域名需委派至 Gcore Managed DNS Zone
│  ├─ 采用 Xray 服务端，结合 Nginx mTLS 客户端证书鉴权回源
│  ├─ 地址候选池：通过亚洲/美国西岸/中国三网及多公共解析器发现真实入口
│  ├─ 定向测速：移动以香港为主、联通以日本为主、电信以洛杉矶为主
│  ├─ 每网最多输出 2 个通过验证的节点，总计 1～6 个，通常为 2 个
│  ├─ 订阅输出：一条订阅链接，按客户端自动下发 Mihomo YAML 或 Base64（`flag=` 可强制）
│  └─ 零损失就地平滑安装/迁移
└─ [5] 组合：直连 Reality + Cloudflare + Gcore（一次部署三个入口）
   ├─ 入口：直连 VLESS Reality（VPS 8443）、Cloudflare XHTTP（6 个优选 IPv4）、Gcore WS 域名节点
   ├─ 前提条件：一个 Cloudflare Zone 下六个子域名（直连/CF 节点/CF 回源/Gcore 节点/Gcore 回源/订阅）
   ├─ 需要：Cloudflare DNS Token、Gcore CDN Token、Globalping Token；云安全组放行 443 与 8443
   ├─ 网络：443 只允许 Cloudflare 与 Gcore 官方回源网段；SSH 端口保持现状不改
   ├─ 订阅：单个 owner Token，三类节点平铺进 AUTO 测速组；不启用用户配额
   └─ apply 只重建本机配置与订阅；apply-cloud 才写 DNS、签发证书并同步 Gcore 资源
订阅输出：只有当前服务器时推荐本机订阅；多台直连节点需要统一下发时选择 Worker 订阅聚合
（在其中一台部署，其余节点写入聚合 JSON）；不需要订阅时保持默认的仅节点。
Worker 聚合会额外占用两个 Cloudflare 一级子域名：公开订阅域名绑定 Worker，私有节点源域名由
Cloudflare 代理回本机 8443 且只允许 Cloudflare 回源，Token 与配额仍由本机 Nginx 判定。
TCP 加速：所有链路默认直接安装并启用 Skyline Speeder（Linux 6.12+ 内核；旧内核会自动安装兼容内核，安装结束后提示重启一次，开机自动启用）。

安装方式（唯一路径，不再提供交互安装）：
  1. easy_all install --print-params --mode <模式> > params.json
  2. 按字段说明填好后：easy_all params.json --check-params
  3. 校验通过后执行：sudo easy_all params.json
参数文件包含 API Token：安装成功后会自动删除；中途失败会保留，排查后请自行删除。
EOF
}

install_usage() {
    cat <<'EOF'
用法: easy_all <参数文件>                     安装（最简形式；安装成功后会自动删除该文件）
      easy_all install <参数文件>               同上
      easy_all <参数文件> --check-params        只校验参数，不修改本机
      easy_all install --print-params --mode <模式>   输出参数模板（JSON 到 stdout）

  也接受 --params <参数文件> 写法；参数文件用 - 表示从标准输入读取，此时需配合 --mode。
  --mode 可用：1|reality 2|cloudflare-streamup 3|bunny-ws 4|gcore 5|combined
安装参数必须一次提供完整；安装过程中不会再提问。
EOF
}

# 安装入口：参数文件 → 模式 → Profile。安装期不再提供交互选项。
install_command() {
    local params_file="" mode="" print_params=0 check_only=0 module=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --params)
            (($# >= 2)) || launcher_die "用法：easy_all install --params <参数文件|->"
            params_file=$2
            shift 2
            ;;
        --check-params)
            # 既支持 "参数文件 --check-params"，也支持 "--check-params 参数文件"。
            check_only=1
            if [[ $# -ge 2 && "${2}" != -* ]]; then
                params_file=$2
                shift 2
            else
                shift
            fi
            ;;
        --print-params)
            print_params=1
            shift
            ;;
        --mode)
            (($# >= 2)) || launcher_die "用法：easy_all install --print-params --mode <模式>"
            mode=$2
            shift 2
            ;;
        -h | --help)
            install_usage
            return 0
            ;;
        -*)
            install_usage >&2
            launcher_die "install 不支持的选项：$1"
            ;;
        *)
            [[ -z "${params_file}" ]] \
                || launcher_die "只能指定一个参数文件（已给出 ${params_file}，又出现 $1）"
            params_file=$1
            shift
            ;;
        esac
    done

    if ((print_params == 1)); then
        [[ -n "${mode}" ]] \
            || launcher_die "--print-params 需要配合 --mode <模式>；可用写法：$(launcher_mode_usage)"
        mode=$(launcher_mode_alias "${mode}") \
            || launcher_die "不支持的安装模式：${mode}；可用写法：$(launcher_mode_usage)"
        EASY_ALL_PARAMS_PRINT=1
        export EASY_ALL_SELECTED_MODE="${mode}"
        module=$(profile_file "${mode}")
        # shellcheck source=/dev/null
        source "${module}"
        register_easy_all_command() { unified_register_easy_all_command; }
        install_params_preflight "${mode}"
        return 0
    fi

    [[ -n "${params_file}" ]] || {
        install_usage >&2
        show_install_guide
        launcher_die "请提供参数文件：easy_all <参数文件>（参数文件用 --print-params --mode <模式> 生成）"
    }
    if ((check_only == 0)); then
        [[ "$(id -u)" -eq 0 ]] || launcher_die "请使用 root 用户运行此脚本"
    else
        # 只校验：安装成功后自动删除参数文件的行为不适用于这里。
        export EASY_ALL_PARAMS_KEEP=1
    fi
    if [[ -n "${mode}" ]]; then
        mode=$(launcher_mode_alias "${mode}") \
            || launcher_die "不支持的安装模式：${mode}；可用写法：$(launcher_mode_usage)"
    fi
    if [[ "${params_file}" == "-" ]]; then
        # 标准输入只能读一次：模式必须显式给出，否则无法在读取之前选中 Profile。
        [[ -n "${mode}" ]] \
            || launcher_die "使用 --params - / --check-params - 时必须同时用 --mode <模式>；可用写法：$(launcher_mode_usage)"
    else
        # 参数层需要 jq（方案 A：校验前只补装 jq 与 ca-certificates）。
        params_install_dependencies
        local file_mode
        file_mode=$(params_peek_mode "${params_file}") \
            || launcher_die "参数文件无效：${params_file}"
        if [[ -n "${mode}" && "${mode}" != "${file_mode}" ]]; then
            launcher_die "参数文件 mode=${file_mode} 与 --mode ${mode} 不一致"
        fi
        mode=${mode:-${file_mode}}
    fi
    detect_installed_mode >/dev/null
    module=$(profile_file "${mode}")
    export EASY_ALL_SELECTED_MODE="${mode}"
    export EASY_ALL_PARAMS_FILE="${params_file}"
    # shellcheck source=/dev/null
    source "${module}"
    register_easy_all_command() { unified_register_easy_all_command; }
    if ((check_only == 1)); then
        install_params_preflight "${mode}"
        printf '参数校验通过：%s（mode=%s）；未修改本机\n' "${params_file}" "${mode}" >&2
        return 0
    fi
    dispatch_profile_command "${mode}" install
}

state_value() {
    local file=$1 key=$2 line value
    [[ -f "${file}" ]] || return 1
    line=$(grep -E "^${key}=" "${file}" | tail -n 1) || return 1
    value=${line#*=}
    value=${value#\'}
    value=${value%\'}
    value=${value#\"}
    value=${value%\"}
    printf '%s\n' "${value}"
}

detect_installed_mode() {
    local protocol="" state_version=""
    if [[ -f "${EASY_ALL_STATE_FILE}" ]]; then
        protocol=$(state_value "${EASY_ALL_STATE_FILE}" PROTOCOL || true)
        state_version=$(state_value "${EASY_ALL_STATE_FILE}" STATE_VERSION || true)
        [[ "${state_version}" == "${CURRENT_STATE_VERSION}" ]] \
            || launcher_die "状态版本不匹配（当前：${state_version:-缺失}，期望：${CURRENT_STATE_VERSION}）；请先执行 sudo easy_all uninstall 清理旧版本本机文件，再重新安装"
        case "${protocol}" in
        reality|cloudflare-streamup|bunny-ws|gcore|combined)
            printf '%s\n' "${protocol}"
            ;;
        *) launcher_die "无法识别已安装协议：${protocol:-缺失}" ;;
        esac
        return
    fi
}

profile_file() {
    local mode=$1 candidate
    case "${mode}" in
    reality) candidate="${EASY_ALL_ROOT}/profiles/reality.sh" ;;
    cloudflare-streamup) candidate="${EASY_ALL_ROOT}/profiles/xhttp-cloudflare-streamup.sh" ;;
    bunny-ws) candidate="${EASY_ALL_ROOT}/profiles/ws-bunny.sh" ;;
    gcore) candidate="${EASY_ALL_ROOT}/profiles/xhttp-gcore.sh" ;;
    combined) candidate="${EASY_ALL_ROOT}/profiles/combined.sh" ;;
    *) launcher_die "不支持的安装模式：${mode}" ;;
    esac
    [[ -f "${candidate}" ]] || launcher_die "缺少 Profile 模块：${candidate}"
    printf '%s\n' "${candidate}"
}

stage_preserved_runtime_files() {
    local current_dir=$1 stage_dir=$2 relative_path
    for relative_path in "${EASY_ALL_PRESERVED_RUNTIME_FILES[@]}"; do
        [[ -f "${current_dir}/${relative_path}" ]] || continue
        install -m 0755 "${current_dir}/${relative_path}" \
            "${stage_dir}/${relative_path}"
    done
}

unified_register_easy_all_command() {
    local source_root=${EASY_ALL_ROOT} destination="${EASY_ALL_INSTALL_DIR}/easy_all"
    local stage backup="${EASY_ALL_INSTALL_DIR}.previous.$$" relative_path paths
    local -a syntax_files
    require_root
    runtime_tree_is_complete "${source_root}" \
        || die "easy_all 运行时文件不完整：${source_root}"
    paths=$(runtime_manifest_paths "${source_root}") \
        || die "easy_all 运行时清单无效：${source_root}/${EASY_ALL_RUNTIME_MANIFEST}"

    install -d -m 0755 "$(dirname "${EASY_ALL_INSTALL_DIR}")" "$(dirname "${EASY_ALL_COMMAND_PATH}")"
    stage=$(mktemp -d "${EASY_ALL_INSTALL_DIR}.stage.XXXXXX")
    declare -p cleanup_files >/dev/null 2>&1 && cleanup_files+=("${stage}")
    install -m 0755 "${source_root}/easy_all" "${stage}/easy_all"
    install -m 0644 "${source_root}/${EASY_ALL_RUNTIME_MANIFEST}" \
        "${stage}/${EASY_ALL_RUNTIME_MANIFEST}"
    syntax_files=("${stage}/easy_all")
    while IFS= read -r relative_path; do
        install -d -m 0755 "${stage}/$(dirname -- "${relative_path}")"
        install -m 0644 "${source_root}/${relative_path}" \
            "${stage}/${relative_path}"
        [[ "${relative_path}" != *.sh ]] \
            || syntax_files+=("${stage}/${relative_path}")
    done <<<"${paths}"
    stage_preserved_runtime_files "${EASY_ALL_INSTALL_DIR}" "${stage}"
    bash -n "${syntax_files[@]}" \
        || { rm -rf -- "${stage}"; die "待注册脚本语法校验失败"; }

    rm -rf -- "${backup}"
    [[ ! -d "${EASY_ALL_INSTALL_DIR}" ]] || mv "${EASY_ALL_INSTALL_DIR}" "${backup}"
    if ! mv "${stage}" "${EASY_ALL_INSTALL_DIR}" \
        || ! ln -sfn "${destination}" "${EASY_ALL_COMMAND_PATH}"; then
        rm -rf -- "${EASY_ALL_INSTALL_DIR}"
        [[ ! -d "${backup}" ]] || mv "${backup}" "${EASY_ALL_INSTALL_DIR}"
        die "注册 easy_all 命令失败，已恢复旧版本"
    fi
    rm -rf -- "${backup}"
    success "已注册命令：${EASY_ALL_COMMAND_PATH}"
}

unified_self_update() {
    local target_branch="${EASY_ALL_BRANCH}" temp_dir repo_dir
    require_root
    command -v git >/dev/null 2>&1 || die "缺少 git；请先安装 git 与 ca-certificates"
    case "$#" in
    0) ;;
    1)
        [[ "$1" == "--dev" ]] \
            || die "用法：easy_all self-update [--dev|--branch <分支>]"
        target_branch="dev"
        ;;
    2)
        [[ "$1" == "--branch" && -n "$2" ]] \
            || die "用法：easy_all self-update [--dev|--branch <分支>]"
        target_branch=$2
        ;;
    *) die "用法：easy_all self-update [--dev|--branch <分支>]" ;;
    esac
    git check-ref-format --branch "${target_branch}" >/dev/null 2>&1 \
        || die "无效的 Git 分支：${target_branch}"

    temp_dir=$(make_temp_dir)
    repo_dir="${temp_dir}/easy_all"
    git clone --depth 1 --branch "${target_branch}" "${EASY_ALL_REPOSITORY_URL}" "${repo_dir}" \
        || die "克隆 easy_all 仓库失败"
    [[ -f "${repo_dir}/easy_all" ]] \
        || die "下载的 easy_all 项目缺少入口：easy_all"
    [[ -f "${repo_dir}/${EASY_ALL_RUNTIME_MANIFEST}" ]] \
        || die "下载的 easy_all 项目缺少运行时清单：${EASY_ALL_RUNTIME_MANIFEST}"
    bash -n "${repo_dir}/easy_all" \
        || die "下载的 easy_all 入口语法校验失败"

    chmod 0700 "${repo_dir}/easy_all"
    "${repo_dir}/easy_all" verify-release \
        || die "下载的 easy_all 项目未通过目标版本完整性校验"
    "${repo_dir}/easy_all" register-command
    rm -rf -- "${temp_dir}"
    success "easy_all 项目代码已更新；未修改 Xray、Nginx、订阅或云端 CDN 资源"
}

dispatch_profile_command() {
    local mode=$1 command=$2
    shift 2
    case "${command}" in
    install) install_all ;;
    show) require_root; show_node ;;
    subscription) require_root; show_subscription ;;
    apply)
        apply_easy_all
        ;;
    tcp-resume) resume_skyline_after_reboot "$@" ;;
    reality-target)
        [[ "${mode}" == "reality" || "${mode}" == "combined" ]] \
            || launcher_die "reality-target 仅适用于 Reality 与组合模式"
        update_reality_target "$@"
        ;;
    apply-cloud)
        [[ "${mode}" == "cloudflare-streamup" || "${mode}" == "bunny-ws" || "${mode}" == "gcore" || "${mode}" == "combined" ]] \
            || launcher_die "apply-cloud 仅适用于 CDN 模式"
        (($# == 0)) || launcher_die "apply-cloud 不接受额外参数"
        if [[ "${mode}" == "bunny-ws" ]]; then
            apply_easy_all
        else
            apply_cloud_resources
        fi
        ;;
    edit-sub)
        [[ "${mode}" != "bunny-ws" ]] || launcher_die "Bunny 仅提供一个 owner 订阅；不支持用户/配额编辑"
        if [[ "${mode}" == "reality" ]]; then
            update_subscription 1
        else
            update_subscription
        fi
        ;;
    update-core)
        update_current_core "$@"
        ;;
    refresh-cdn-ips)
        if [[ "${mode}" == "cloudflare-streamup" ]]; then
            refresh_cloudflare_cdn_ips
        elif [[ "${mode}" == "gcore" ]]; then
            refresh_gcore_cdn_ips
        elif [[ "${mode}" == "combined" ]]; then
            refresh_combined_cdn_ips
        else
            launcher_die "refresh-cdn-ips 仅适用于 CDN 精选 IP 模式"
        fi
        ;;
    renew-cert)
        case "${mode}" in
        reality) renew_subscription_certificate ;;
        bunny-ws) renew_bunny_certificate 1 ;;
        cloudflare-streamup) renew_certificate ;;
        gcore) xhttp_renew_origin_certificate ;;
        combined) renew_certificate ;;
        *) launcher_die "当前模式不使用 TLS 证书，无需续期" ;;
        esac
        ;;
    cert-renew)
        case "${mode}" in
        bunny-ws) renew_bunny_certificate ;;
        *) launcher_die "cert-renew 仅适用于 Bunny 模式" ;;
        esac
        ;;
    refresh-origin-ips)
        [[ "${mode}" == "bunny-ws" ]] || launcher_die "refresh-origin-ips 仅适用于 Bunny 模式"
        refresh_bunny_origin_ips
        ;;
    rotate-dynamic-ports)
        case "${mode}" in
        reality) rotate_dynamic_ports ;;
        *) launcher_die "rotate-dynamic-ports 仅适用于 Reality 模式" ;;
        esac
        ;;
    quota-sync)
        case "${mode}" in
        bunny-ws | combined) return 0 ;;
        esac
        quota_sync_usage
        ;;
    quota-status)
        [[ "${mode}" != "combined" ]] || launcher_die "组合模式不启用用户配额"
        [[ "${mode}" != "bunny-ws" ]] || launcher_die "Bunny 不支持 easy_all 用户配额"
        require_root
        collect_installed_state
        show_quota_status
        ;;
    quota-set)
        [[ "${mode}" != "combined" ]] || launcher_die "组合模式不启用用户配额"
        [[ "${mode}" != "bunny-ws" ]] || launcher_die "Bunny 不支持 easy_all 用户配额"
        quota_set_user "$@"
        ;;
    quota-reset)
        [[ "${mode}" != "combined" ]] || launcher_die "组合模式不启用用户配额"
        [[ "${mode}" != "bunny-ws" ]] || launcher_die "Bunny 不支持 easy_all 用户配额"
        quota_reset_user "$@"
        ;;
    status) show_status ;;
    self-update) unified_self_update "$@" ;;
    register-command) register_easy_all_command ;;
    uninstall) uninstall_all "$@" ;;
    help | -h | --help) launcher_usage ;;
    *) launcher_usage; return 1 ;;
    esac
}

main() {
    local command=${1:-install} mode="" module state_version=""
    shift || true

    # easy_all <参数文件>：最简安装形式（bootstrap.sh 会把参数原样透传过来）。
    case "${command}" in
    - | *.json)
        install_command "${command}" "$@"
        return
        ;;
    esac
    if [[ -f "${command}" && "${command}" != -* ]]; then
        launcher_die "参数文件需要 .json 扩展名：easy_all ${command}.json（或 easy_all install --params ${command}）"
    fi

    if [[ "${command}" == "help" || "${command}" == "-h" || "${command}" == "--help" ]]; then
        launcher_usage
        return
    fi
    if [[ "${command}" == "purge-gcore" ]]; then
        bash "${EASY_ALL_ROOT}/lib/gcore-purge.sh" "$@"
        exit
    fi
    if [[ "${command}" == "purge-cloudflare" ]]; then
        bash "${EASY_ALL_ROOT}/lib/cloudflare-purge.sh" "$@"
        exit
    fi
    if [[ "${command}" == "cleanup-partial" ]]; then
        cleanup_partial_install_command "$@"
        exit
    fi
    if [[ "${command}" == "verify-release" ]]; then
        (($# == 0)) || launcher_die "verify-release 不接受参数"
        runtime_tree_is_complete "${EASY_ALL_ROOT}" \
            || launcher_die "easy_all 运行时文件不完整：${EASY_ALL_ROOT}"
        return
    fi

    if [[ "${command}" == "uninstall" && -f "${EASY_ALL_STATE_FILE}" ]]; then
        state_version=$(state_value "${EASY_ALL_STATE_FILE}" STATE_VERSION || true)
        if [[ "${state_version}" != "${CURRENT_STATE_VERSION}" ]]; then
            legacy_local_uninstall "$@"
            return
        fi
    fi
    if [[ "${command}" == "install" ]]; then
        install_command "$@"
        return
    fi
    if [[ "${command}" == "uninstall" ]]; then
        mode=$(detect_installed_mode)
        if [[ -z "${mode}" && "$#" == 1 && "${1:-}" == "--purge-cloud" \
            && -f "${EASY_ALL_BUNNY_JOURNAL}" ]]; then
            mode="bunny-ws"
        fi
    else
        mode=$(detect_installed_mode)
    fi
    [[ -n "${mode}" ]] || launcher_die "easy_all 尚未安装"

    module=$(profile_file "${mode}")
    export EASY_ALL_SELECTED_MODE="${mode}"
    # shellcheck source=/dev/null
    source "${module}"

    register_easy_all_command() {
        unified_register_easy_all_command
    }
    dispatch_profile_command "${mode}" "${command}" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
